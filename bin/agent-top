#!/usr/bin/env python3
"""agent-top — live console for the headless agents: who is alive, what each one does now, what it said.

  agent-top [--stage S ...] [--all] [--interval 1.5] [--read-only]   interactive (curses)
  agent-top --once [--stage S ...] [--all] [--width N] [--agent R] [--lines N]   text picture, no curses
  agent-top --json [--stage S ...] [--all] [--agent R] [--feed N]     the same data for scripts
  agent-top --widget [--stage S ...] [--all]                          HTML fragment of the snapshot (host CSS variables, no scripts)

Shows every agent of every stage (<hub home>/<stage>/agents/<R>/): state (live / done / error / died — decided as
`agent status` does: the pid is alive AND its command line holds the session id; else the last `result` event of
the log), the model (the id the run reported: sonnet-5-5, not the alias it was asked for), age of the last log event,
model turns (the last run's next to the total once an agent was resumed: 31/60), context size, cost of the finished
runs, the current action
(the last tool_use with no tool_result yet), the last thing the agent said, unread inbox messages. Sub-agents
(the Agent tool) of the sessions in a stage's role registry are listed too, read-only, as `<parent role>/<id>`:
found in the parent session's transcript folder (<claude config>/projects/*/<session>/subagents/); done/error/died
from the parent's completion notice (a foreground one: the result of its Agent call); without one it is live while
the parent session runs (<claude config>/sessions/<pid>.json with a live claude pid) and died once it is gone —
where that folder does not exist, died after 30 min of silence. Native Codex actors use persisted terminal
events and confirmed process/current-session evidence; without either, state is unknown. After one hour without
activity the observation expires and stops blocking handoff. Show-all retains expired observations; confirmed
live actors never expire.
An interrupted native turn is stopped, distinct from failed. Enter opens an
agent: live feed of its log (thoughts ✎, commands ▸, short results ◂), brief, inbox. `j` — stage journal with a
filter, `s` — stages, locks, owner questions, roles, plan limits. `m` sends a message and `x` stops an agent through
`agent send` / `agent stop`, `c` closes a stage through `hub close`, each after a y/N confirmation; nothing else is ever
written.
Homes: it shows the stages of every known hub home, not only the one the working directory resolves to: the resolved
home, ~/agent-hub, the legacy home, $AGENT_HUB_HOME and the homes in the registry (${XDG_CONFIG_HOME:-~/.config}/delamain/
homes.json, written when a stage is registered in a home; hubcore.known_homes). While stages come from more than one
home, a stage outside ~/agent-hub is named `stage · <repo>` (the repository of a project home, else the ~-path): that
name is its `stage` in --json, for display and as a key within one snapshot only: a stage is identified by its home and
own name (`home`, `name`/`stage_name` in the records), which no label or other home changes, and every action (stop,
send, close, a card) is addressed to that pair. --stage takes NAME (that stage in every home), NAME@LABEL or
NAME@/path/of/home (one home's; `@` alone after the name is ~/agent-hub) and the displayed `name · label`; `homes` lists the
known homes. With one home nothing changes.
Stages: a stage closed by `hub close` (stage.json "closed") is left out unless --all or named by --stage (`closed_hidden`
in --json lists the ones left out). `stage_info` gives each shown stage's goal, closed record, live agents and last
activity (newest of its journal, agent logs, roles and questions); a stage that is open, has no live agent and was quiet
for $AGENT_TOP_IDLE_S (default 48 h) is `idle` — a candidate for `hub close`.

Keys: ↑↓ select/scroll · ⏎ open · Esc back · Tab tab · j journal · s summary · a all agents · m message · x stop ·
c close a stage · r refresh · ? help · q quit.  --read-only disables m, x and c.
Logs are read incrementally from the last offset (log.jsonl reaches several MB): only assistant/result lines are
parsed, a log over $AGENT_TOP_SCAN_MAX bytes (8 MB) is scanned from its tail and its turn count is marked with +.
The offsets and what was read up to them outlive the process in a cache, <state dir>/agent-top/cache.sqlite (state dir:
$AGENT_HUB_STATE_DIR, else <hub home>/.state; bin/topcache.py), so a new `--json` (the mod runs one every few seconds)
reads only what the logs gained since the last one; AGENT_TOP_CACHE=0 reads everything afresh and writes no cache.
Files of agents are never opened for writing; that cache is the only file agent-top writes.
Cost: a Claude agent's is the latest cumulative `total_cost_usd` of each of its sessions, summed over sessions; a Codex
agent's tokens are the latest cumulative count of each of its threads (a count seen before any init is its own bucket and
makes the total `partial`). `spend` (--json, and a line in --once) is the
stage's agents' dollars against its hub's: the hub's are logged when it is a headless agent, else estimated from its
session transcript's tokens at the per-model price the agents' results show (≈; a hub without a Claude transcript has none).
Env: AGENT_HUB_HOME (hub home; `hub home` shows which and why), CLAUDE_CONFIG_DIR (default ~/.claude), AGENT_HUB_TZ (time zone of clocks and the journal,
default: local), AGENT_TOP_AGENT_BIN (the `agent` script; tests), AGENT_TOP_SCAN_MAX (bytes, default 8 MB),
AGENT_TOP_CACHE (0: no disk cache), AGENT_TOP_IDLE_S (seconds, default 172800), AGENT_TOP_HUB_BIN (the `hub` script; tests),
NO_COLOR.
Exit: 0 ok, 1 unknown agent, 2 usage.  Python 3.10+ stdlib only.
"""
from __future__ import annotations

import argparse
import contextlib
import curses
import datetime as dt
import html
import importlib.machinery
import importlib.util
import json
import locale
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import unicodedata
from pathlib import Path
from typing import NamedTuple

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hubcore as hc  # noqa: E402
import engines  # noqa: E402
import codex_rollouts  # noqa: E402
import codex_limits  # noqa: E402
import limit_pace  # noqa: E402
import subagents  # noqa: E402  (sub-agent discovery and state, shared with `hub handoff`)
import topcache  # noqa: E402  (the readers' offsets between runs: <state dir>/agent-top/cache.sqlite)
from subagents import (UUID_RE, TOOL_ID_RE as _TOOL_ID_RE, is_alive, line_ts as _line_ts,  # noqa: E402
                       live_sessions, loads as _loads, parse_ts, process_table, read_json)

BIN = hc.BIN
STALE_S = 300                     # a live agent silent this long is flagged "quiet"
RECENT_S = 24 * 3600              # finished agents older than this are hidden without --all / `a`
IDLE_S = int(os.environ.get("AGENT_TOP_IDLE_S") or 48 * 3600)   # an open stage this quiet with no live agent is idle
SCAN_MAX = int(os.environ.get("AGENT_TOP_SCAN_MAX") or 8 * 1024 * 1024)
FEED_TAIL_BYTES = 400_000
FLUSH_S = 2.0                     # a long first read writes the disk cache this often, not only at its end
FEED_MAX_ITEMS = 4000
ARCHIVE_RE = re.compile(r"^(?P<role>.+)\.(?:failed-)?\d{8}-\d{6}$")
_TYPE_RE = re.compile(rb'^\{\s*"type"\s*:\s*"([\w.]+)"')
_RESULT_RE = re.compile(rb'"type"\s*:\s*"result"')   # the CLI writes `result` events with "duration_api_ms" first
_CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
_DONE_RE = re.compile(r"\bDONE\b")
HOME_SEP = " · "                  # between a stage and its home label while stages come from more than one home
ASK_LINE_RE = re.compile(r"^(\S+) — open (\d+), overdue (\d+)")
QUESTION_ID_RE = re.compile(r"^(Q-[A-Za-z0-9]+-\d+)(?=\s|$)")  # the unindented id line of `ask list`; blocks:/asked are indented


# ---------------------------------------------------------------- text helpers

def cw(ch: str) -> int:
    if unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def dispw(s: str) -> int:
    return sum(cw(c) for c in s)


def clip(s: str, w: int, ellipsis: bool = True) -> str:
    """Cut to display width w; an ellipsis marks the cut."""
    if w <= 0:
        return ""
    if dispw(s) <= w:
        return s
    out, used = [], 0
    room = w - 1 if ellipsis else w
    for ch in s:
        c = cw(ch)
        if used + c > room:
            break
        out.append(ch)
        used += c
    return "".join(out) + ("…" if ellipsis else "")


def pad(s: str, w: int) -> str:
    s = clip(s, w)
    return s + " " * (w - dispw(s))


def wrap(s: str, w: int, first: str = "", rest: str = "", max_lines: int = 0) -> list:
    """Greedy word wrap by display width; `first`/`rest` are the indents of the first and the next lines."""
    w = max(w, 8)
    lines, cur, indent = [], "", first
    for word in s.split(" "):
        while dispw(word) > w - dispw(indent):  # a word longer than the line: hard cut
            room = w - dispw(indent) - (1 if cur else 0)
            if cur and room >= 6:
                head = clip(word, room, ellipsis=False)
                lines.append(indent + cur + " " + head)
                word, cur, indent = word[len(head):], "", rest
                continue
            if cur:
                lines.append(indent + cur)
                cur, indent = "", rest
                continue
            head = clip(word, w - dispw(indent), ellipsis=False) or word[:1]
            lines.append(indent + head)
            word, indent = word[len(head):], rest
        if not word:
            continue
        if cur and dispw(indent) + dispw(cur) + 1 + dispw(word) > w:
            lines.append(indent + cur)
            cur, indent = word, rest
        else:
            cur = f"{cur} {word}" if cur else word
    if cur or not lines:
        lines.append(indent + cur)
    if max_lines and len(lines) > max_lines:
        lines = lines[:max_lines]
        lines[-1] = clip(lines[-1] + " …", w)
    return lines


def one_line(s: str) -> str:
    return " ".join(_CTRL_RE.sub(" ", s).split())


def text_lines(s: str, max_lines: int = 12) -> list:
    """Paragraph lines of a message: blanks collapsed, control characters gone."""
    out = []
    for ln in s.splitlines():
        ln = " ".join(_CTRL_RE.sub(" ", ln).split())
        if ln or (out and out[-1]):
            out.append(ln)
    while out and not out[-1]:
        out.pop()
    return out[:max_lines] + (["…"] if len(out) > max_lines else [])


def num(v, default=0):
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def pct(w) -> str:
    try:
        return f"{int(round(100 * float(w.get('utilization') or 0)))}%"
    except (TypeError, ValueError, AttributeError):
        return "?"


def fmt_age(s) -> str:
    if s is None:
        return "—"
    s = max(0, int(s))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h{s % 3600 // 60:02d}"
    return f"{s // 86400}d"


def fmt_k(n) -> str:
    if not n:
        return "—"
    return str(n) if n < 1000 else (f"{n / 1000:.0f}k" if n < 1_000_000 else f"{n / 1_000_000:.1f}M")


def fmt_cost(c) -> str:
    return "—" if c is None else f"${c:.2f}"


def tildify(p: str) -> str:
    home = str(Path.home())
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def hhmmss(ts) -> str:
    return dt.datetime.fromtimestamp(ts, hc.TZ).strftime("%H:%M:%S") if ts else ""


def short_model(m: str, effort) -> str:
    m = re.sub(r"-\d{8}$", "", (m or "?").replace("claude-", ""))
    eff = {"low": "lo", "medium": "md", "high": "hi", "xhigh": "xh", "max": "mx"}.get(effort or "", "")
    return m + ("/" + eff if eff else "")


# The context window by model id, where the log has not reported one (Claude reports it in the result event's
# modelUsage, Codex in its rollout). Values as Claude Code 2.1.289 reported them on this machine, 2026-10.
CTX_WINDOWS = (("opus-5", 1_000_000), ("sonnet-5", 1_000_000), ("fable-5", 1_000_000), ("haiku-4", 200_000))
CTX_DEFAULT = 200_000


def model_usage_window(usage, model) -> int:
    """contextWindow of the run's own model in a result event's modelUsage (sub-agents' models are listed beside it)."""
    if not isinstance(usage, dict) or not isinstance(model, str) or not model:
        return 0
    base = re.sub(r"\[.*\]$", "", model)
    for name, rec in usage.items():
        if isinstance(rec, dict) and isinstance(rec.get("contextWindow"), int) and rec["contextWindow"] > 0 \
                and (name == model or name == base or name.startswith(base + "-")):
            return rec["contextWindow"]
    return 0


def ctx_window(model_id, reported, ctx) -> int:
    """The model's context window: the one the log reported, else by model id ("[1m]" means 1M), else 200k; never
    below the context already used (a 200k guess under a 300k context is a 1M model)."""
    if isinstance(reported, int) and reported > 0:
        win = reported
    else:
        m = (model_id or "").lower()
        win = 1_000_000 if "[1m]" in m else next((w for k, w in CTX_WINDOWS if k in m), CTX_DEFAULT)
    return 1_000_000 if isinstance(ctx, int) and ctx > win else win


def model_label(a: dict) -> str:
    """model/effort as shown: the id the run reported ("sonnet-5-5"), else the model that was asked for."""
    return short_model(a.get("model_id") or a["model"], a["effort"])


def turns_label(a: dict, sep: str = "/") -> str:
    """Turns of the agent: "29", or the last run's next to the total once a resumed run's differ ("31/60")."""
    total = f"{a['turns']}{'+' if a['turns_approx'] else ''}"
    return total if a["run_turns"] == a["turns"] else f"{a['run_turns']}{sep}{total}"


def tool_brief(name: str, inp) -> tuple:
    """(headline, detail) of a tool call: what the agent is doing, and the command behind it."""
    inp = inp if isinstance(inp, dict) else {}

    def s(k):
        v = inp.get(k)
        return v.strip() if isinstance(v, str) else ""

    if name == "Bash":
        cmd, desc = s("command"), s("description")
        return (desc, one_line(cmd)) if desc else (one_line(cmd.splitlines()[0] if cmd else ""), "")
    if name in ("Read", "Write", "Edit", "NotebookEdit"):
        return tildify(s("file_path") or s("notebook_path")), ""
    if name in ("Grep", "Glob"):
        return (s("pattern") + (f"  in {tildify(s('path'))}" if s("path") else "")), ""
    if name in ("Agent", "Task"):
        return f"{s('subagent_type') or 'agent'}: {s('description')}", one_line(s("prompt"))[:300]
    if name == "Skill":
        return s("skill"), ""
    if name in ("WebFetch", "WebSearch", "ToolSearch"):
        return s("url") or s("query"), ""
    for v in inp.values():
        if isinstance(v, str) and v.strip():
            return one_line(v)[:200], ""
    return "", ""


def tool_label(name: str) -> str:
    return name if not name.startswith("mcp__") else "…".join(name.split("__")[-2:])


# ---------------------------------------------------------------- log scanning

class LogState:
    """Everything the list needs from one log.jsonl, kept incrementally: only new complete lines are read."""

    def __init__(self, path: Path):
        self.path = path
        self.reset()

    def reset(self):
        self.ino, self.offset, self.size, self.mtime = None, 0, 0, 0.0
        self.turn_ids, self.sub_ids, self.n_anon = set(), set(), 0
        self.run_turn_ids, self.run_n_anon = set(), 0   # the same for the last run (a resumed session logs one init per run)
        self.model = None                 # the id the last run's init event reports (what an alias resolved to)
        self.events = self.inits = self.tool_calls = 0
        self.pending = {}                 # tool_use_id -> {"tool", "text", "detail", "ts"}
        self.last_text, self.last_text_ts = "", None
        self.last_tool = None
        self.ctx = 0
        self.last_result, self.n_results = None, 0
        self.cost_by_sid = {}             # session id -> the last `total_cost_usd`: the CLI reports it cumulative for the whole session
        self.init_sid = ""                # the session of the latest init: the owner of a `result` that names none
        self.running = False              # an init after the last result: a run is (or was) in progress
        self.inbox_touch, self.done_at = -1, -1
        self.truncated = False
        self.rate, self.rate_mtime = None, 0.0
        self.effort = None                # a session transcript records the effort on each assistant line
        self.last_user_ts = None          # …and a timestamp on each line: the newest user line (prompt, tool result)
        self.engine = "claude"
        self.codex_turns = self.codex_run_turns = 0
        self.usage_tokens = self.ctx_source = self.context_window = self.codex_rate_limits = None
        self.usage_scope = None
        self.codex_sid = ""               # the thread of the latest init: a resumed run logs the same thread again
        self.usage_by_sid = {}            # thread id -> its latest cumulative token usage
        self.model_usage = None           # the last result's modelUsage: per model, its contextWindow among others
        self.rollout = codex_rollouts.Normalizer()
        self.last_event_ts = None
        self.native_rollout = False

    @property
    def cost_sum(self):
        """Cost of the log: each session's latest cumulative total (a resumed run continues the same counter), summed
        over sessions; None while no result carried one."""
        return sum(self.cost_by_sid.values()) if self.cost_by_sid else None

    @property
    def turns(self) -> int:
        if self.engine == "codex":
            return self.codex_turns
        return len(self.turn_ids) + self.n_anon

    @property
    def run_turns(self) -> int:
        if self.engine == "codex":
            return self.codex_run_turns
        return len(self.run_turn_ids) + self.run_n_anon

    @property
    def sub_turns(self) -> int:
        return len(self.sub_ids)

    def ctx_window(self, model) -> int:
        return ctx_window(model, self.context_window or model_usage_window(self.model_usage, model), self.ctx)

    def update(self) -> None:
        try:
            st = os.stat(self.path)
        except OSError:
            self.reset()
            return
        if st.st_ino != self.ino or st.st_size < self.offset:
            self.reset()
            self.ino = st.st_ino
        self.size, self.mtime = st.st_size, st.st_mtime
        skip_partial = False
        if self.offset == 0 and st.st_size > SCAN_MAX:
            self.offset, self.truncated, skip_partial = st.st_size - SCAN_MAX, True, True
        if st.st_size <= self.offset:
            return
        try:
            with open(self.path, "rb") as fh:
                fh.seek(self.offset)
                if skip_partial:
                    self.offset += len(fh.readline())
                while True:
                    line = fh.readline()
                    if not line or not line.endswith(b"\n"):
                        break               # EOF or a line still being written: wait for the rest
                    self._feed(self.offset, line)
                    self.offset += len(line)
        except OSError:
            return

    def _feed(self, pos: int, line: bytes) -> None:
        typ = event_type(line)
        if not typ:
            return
        if b"." in typ or typ in (b"session_meta", b"response_item", b"event_msg", b"turn_context"):
            ev = _loads(line)
            if not ev:
                return
            if "payload" in ev:
                self.native_rollout = True
            normalized = (self.rollout.events(ev) if "payload" in ev else engines.normalize_event(ev))
            at = self.rollout.last_event_ts if "payload" in ev else parse_ts(ev.get("timestamp"))
            if at is not None and (self.last_event_ts is None or at > self.last_event_ts):
                self.last_event_ts = at
            for common in normalized:
                self._common(pos, common)
            return
        self._legacy_feed(pos, line, typ)

    def _common(self, pos, ev):
        self.engine = "codex"
        typ = ev.get("type")
        if typ == "codex_turn_start" or typ == "system" and ev.get("subtype") == "turn_start":
            self.codex_turns += 1
            self.codex_run_turns += 1
            self.running = True
            self.last_result = None
            self.pending.clear()
            return
        if typ == "codex_context":
            self.model, self.effort = ev.get("model"), ev.get("effort")
            return
        usage = ev.get("codex_usage")
        if isinstance(usage, dict):
            # Codex counts are cumulative per thread, and a resumed run logs the same thread again: keep the latest
            # count of each thread, never add runs of one thread together.
            self.usage_by_sid[self.codex_sid] = dict(usage)
            self._sum_usage()
        if isinstance(ev.get("context_tokens"), int):
            # Codex's total input usage sums every model call. Only the most
            # recent call's input size is comparable to Claude's context metric.
            self.ctx, self.ctx_source = ev["context_tokens"], "last_input_tokens"
        if isinstance(ev.get("context_window"), int):
            self.context_window = ev["context_window"]
        if isinstance(ev.get("codex_rate_limits"), dict):
            self.codex_rate_limits = ev["codex_rate_limits"]
        if typ == "system" and ev.get("subtype") == "init":
            self.codex_run_turns = 0
            if isinstance(ev.get("session_id"), str):
                self.codex_sid = ev["session_id"]
        if typ == "result" and not ev.get("result"):
            errors = ev.get("errors") or []
            detail = "; ".join(str(err.get("message") or err) if isinstance(err, dict) else str(err)
                               for err in errors if err)
            ev = {**ev, "result": detail or self.last_text}
        if typ in ("assistant", "user", "result", "system"):
            self._legacy_feed(pos, json.dumps(ev).encode(), str(typ).encode())

    def _sum_usage(self) -> None:
        counts = list(self.usage_by_sid.values())
        self.usage_tokens = {key: sum(num(u.get(key)) for u in counts) for key in dict.fromkeys(k for u in counts for k in u)}
        # A count read before any init (a log scanned from its tail) belongs to an unknown thread, kept in its own bucket
        # (key ""): it may be the thread that follows or an older one, so the total is marked partial, not guessed.
        self.usage_scope = ("partial" if "" in self.usage_by_sid and len(self.usage_by_sid) > 1
                            else "session" if len(self.usage_by_sid) == 1 else "sessions")

    def _legacy_feed(self, pos, line, typ):
        if typ == b"assistant":
            ev = _loads(line)
            if ev:
                self._assistant(pos, ev)
        elif typ == b"user":
            for tid in _TOOL_ID_RE.findall(line):
                self.pending.pop(tid.decode("utf-8", "replace"), None)
            ts = _line_ts(line) if line.startswith(b'{"parentUuid"') or self.engine == "codex" else None
            if ts is not None and (self.last_user_ts is None or ts > self.last_user_ts):
                self.last_user_ts = ts
        elif typ == b"result":
            ev = _loads(line)
            if ev:
                self.last_result, self.running = ev, False
                self.n_results += 1
                cost = ev.get("total_cost_usd")
                if isinstance(cost, (int, float)):
                    self.cost_by_sid[str(ev.get("session_id") or self.init_sid)] = cost
                if isinstance(ev.get("modelUsage"), dict):
                    self.model_usage = ev["modelUsage"]
                if _DONE_RE.search(str(ev.get("result") or "")):
                    self.done_at = pos
                self.pending.clear()
            self.events += 1
            return
        elif typ == b"system":
            if re.search(rb'"subtype"\s*:\s*"init"', line[:300]):
                self.running, self.inits = True, self.inits + 1
                self.pending.clear()
                self.run_turn_ids, self.run_n_anon = set(), 0
                ev = _loads(line)
                if isinstance(ev, dict) and isinstance(ev.get("model"), str):
                    self.model = ev["model"]
                if isinstance(ev, dict) and isinstance(ev.get("session_id"), str):
                    self.init_sid = ev["session_id"]
        elif typ == b"rate_limit_event":
            ev = _loads(line)
            if ev and isinstance(ev.get("rate_limit_info"), dict):
                self.rate, self.rate_mtime = ev["rate_limit_info"], self.mtime
        self.events += 1

    def _assistant(self, pos: int, ev: dict) -> None:
        msg = ev.get("message") or {}
        if ev.get("parent_tool_use_id"):     # a sub-agent's chatter is not this agent's turn
            if msg.get("id"):
                self.sub_ids.add(msg["id"])
            return
        if isinstance(ev.get("effort"), str):
            self.effort = ev["effort"]
        if self.engine != "codex":
            mid = msg.get("id")
            if mid:
                self.turn_ids.add(mid)
                self.run_turn_ids.add(mid)
            else:
                self.n_anon += 1
                self.run_n_anon += 1
        usage = msg.get("usage")
        if isinstance(usage, dict):
            ctx = sum(int(usage.get(k) or 0) for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
            if ctx:
                self.ctx = ctx
        ts = parse_ts(ev.get("timestamp"))
        for b in msg.get("content") or []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and str(b.get("text") or "").strip():
                self.last_text, self.last_text_ts = one_line(b["text"])[:700], ts
            elif b.get("type") == "tool_use":
                name = str(b.get("name") or "?")
                head, detail = tool_brief(name, b.get("input"))
                rec = {"tool": name, "text": head, "detail": detail, "ts": ts}
                self.pending[str(b.get("id"))] = rec
                self.last_tool = rec
                self.tool_calls += 1
                if "inbox.md" in json.dumps(b.get("input"), ensure_ascii=False):
                    self.inbox_touch = pos

    def action(self):
        """The tool the agent is inside right now (the newest tool_use with no result yet), or None."""
        return list(self.pending.values())[-1] if self.pending else None


def event_type(line: bytes) -> bytes:
    m = _TYPE_RE.match(line)
    if m:
        return m.group(1)
    if line.startswith(b'{"parentUuid"') or b'"payload"' in line[:160]:
        # a session transcript line (a sub-agent's log): its own "type" key comes after the nested message's
        ev = _loads(line)
        return str(ev.get("type") or "").encode() if ev else b""
    return b"result" if _RESULT_RE.search(line) else b""


# What one token costs relative to an input token. The CLI reports dollars only in a headless `result`; a hub (a
# Desktop/terminal session) writes tokens and no dollars, so its spend is an estimate: the observed price of the model's
# weighted tokens (these ratios) in the agents' own results. The prices of the real models differ from the ratios by
# up to ~20 %, which is why a hub's spend is shown as an estimate, never as a bill.
TOKEN_WEIGHTS = (("inputTokens", "input_tokens", 1.0), ("cacheCreationInputTokens", "cache_creation_input_tokens", 1.25),
                 ("cacheReadInputTokens", "cache_read_input_tokens", 0.1), ("outputTokens", "output_tokens", 5.0))


LINE_MAX = 16 * 1024 * 1024       # a transcript line is read whole up to this; a longer one (a huge tool result) is skipped


def weighted_tokens(usage: dict, snake: bool) -> float:
    return sum(num(usage.get(s if snake else c)) * w for c, s, w in TOKEN_WEIGHTS)


class Transcript:
    """A hub session's transcript (<claude config>/projects/*/<session>.jsonl), read incrementally for its token usage
    per model: the last usage of each assistant message (a message is written once per content block, one after another).
    A read takes at most `budget` bytes, so a huge first read spreads over several snapshots (`complete` is False
    until the end of the file is reached)."""

    def __init__(self, path: Path):
        self.path = path
        self.ino, self.offset, self.size = None, 0, 0
        self.by_model = {}                # model -> usage of the messages already closed {"input_tokens": ..}
        self.cur_id, self.cur_model, self.cur = None, None, {}
        self.skipped = 0                  # lines over LINE_MAX left unread: the totals miss their usage

    @property
    def complete(self) -> bool:
        return self.offset >= self.size and not self.skipped

    def totals(self) -> dict:
        out = {m: dict(u) for m, u in self.by_model.items()}
        if self.cur_model:
            acc = out.setdefault(self.cur_model, {})
            for _, s, _ in TOKEN_WEIGHTS:
                acc[s] = acc.get(s, 0) + num(self.cur.get(s))
        return out

    def _close(self) -> None:
        if self.cur_model:
            acc = self.by_model.setdefault(self.cur_model, {})
            for _, s, _ in TOKEN_WEIGHTS:
                acc[s] = acc.get(s, 0) + num(self.cur.get(s))
        self.cur_id, self.cur_model, self.cur = None, None, {}

    def _apply(self, mid, model, usage) -> None:
        if not isinstance(usage, dict) or not isinstance(model, str) or model.startswith("<"):
            return
        if mid != self.cur_id or not mid:
            self._close()
        self.cur_id, self.cur_model, self.cur = mid, model, usage

    def _line(self, line: bytes) -> None:
        if b'"usage"' not in line or b'"assistant"' not in line:
            return
        ev = _loads(line)
        msg = ev.get("message") if isinstance(ev, dict) else None
        if isinstance(msg, dict) and ev.get("type") == "assistant" and not ev.get("parent_tool_use_id"):
            self._apply(msg.get("id"), msg.get("model"), msg.get("usage"))

    def update(self, budget: int) -> None:
        """Reads whole lines from the offset until `budget` bytes are passed. The offset never moves past an unterminated
        line (it is still being written); a terminated line over LINE_MAX is skipped and counted in `skipped`."""
        try:
            st = os.stat(self.path)
        except OSError:
            return
        if st.st_ino != self.ino or st.st_size < self.offset:
            self.__init__(self.path)
            self.ino = st.st_ino
        self.size = st.st_size
        try:
            with open(self.path, "rb") as fh:
                fh.seek(self.offset)
                end = self.offset + budget
                while self.offset < end:
                    line = fh.readline(LINE_MAX + 1)
                    if not line:
                        break
                    if len(line) > LINE_MAX and not line.endswith(b"\n"):
                        n = len(line)
                        while True:                     # the rest of the oversize line, a piece at a time, kept nowhere
                            more = fh.readline(1 << 20)
                            n += len(more)
                            if not more or more.endswith(b"\n"):
                                break
                        if not more:
                            break                       # unterminated
                        self.offset += n
                        self.skipped += 1
                    elif line.endswith(b"\n"):
                        self.offset += len(line)
                        self._line(line)
                    else:
                        break
        except OSError:
            return


class Item:
    __slots__ = ("ts", "kind", "text", "detail", "sub", "tool_id", "tool")

    def __init__(self, ts, kind, text, detail="", sub=False, tool_id="", tool=""):
        self.ts, self.kind, self.text, self.detail, self.sub, self.tool_id, self.tool = ts, kind, text, detail, sub, tool_id, tool


class Feed:
    """Feed of one agent's log: the last FEED_TAIL_BYTES on the first read, then only what was appended."""

    def __init__(self, path: Path):
        self.path = path
        self.items, self.tool_names, self.done_ids = [], {}, set()
        self.ino, self.offset, self.version, self.truncated = None, 0, 0, False
        self.rollout = codex_rollouts.Normalizer()

    def update(self) -> None:
        try:
            st = os.stat(self.path)
        except OSError:
            return
        if st.st_ino != self.ino or st.st_size < self.offset:
            self.items, self.tool_names, self.done_ids, self.offset, self.truncated = [], {}, set(), 0, False
            self.rollout = codex_rollouts.Normalizer()
            self.ino = st.st_ino
        if st.st_size <= self.offset:
            return
        try:
            with open(self.path, "rb") as fh:
                if self.offset == 0 and st.st_size > FEED_TAIL_BYTES:
                    self.offset, self.truncated = st.st_size - FEED_TAIL_BYTES, True
                    fh.seek(self.offset)
                    self.offset += len(fh.readline())
                fh.seek(self.offset)
                while True:
                    line = fh.readline()
                    if not line or not line.endswith(b"\n"):
                        break
                    self.offset += len(line)
                    typ = event_type(line)
                    if typ in (b"assistant", b"user", b"result", b"system", b"session_meta", b"response_item", b"event_msg", b"turn_context") or b"." in typ:
                        ev = _loads(line)
                        if ev:
                            normalized = self.rollout.events(ev) if "payload" in ev else engines.normalize_event(ev)
                            for common in normalized:
                                if common.get("type") == "result" and not common.get("result") and common.get("errors"):
                                    common = {**common, "result": "; ".join(str(err.get("message") or err) if isinstance(err, dict) else str(err)
                                                                            for err in common["errors"] if err)}
                                self.items.extend(self._items(common))
        except OSError:
            return
        del self.items[:-FEED_MAX_ITEMS]
        self.version += 1

    def _items(self, ev: dict) -> list:
        typ, ts, sub = ev.get("type"), parse_ts(ev.get("timestamp")), bool(ev.get("parent_tool_use_id"))
        out = []
        if typ == "assistant":
            for b in (ev.get("message") or {}).get("content") or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and str(b.get("text") or "").strip():
                    out.append(Item(ts, "text", b["text"], sub=sub))
                elif b.get("type") == "thinking" and str(b.get("thinking") or "").strip():
                    out.append(Item(ts, "thinking", b["thinking"], sub=sub))
                elif b.get("type") == "tool_use":
                    name = str(b.get("name") or "?")
                    head, detail = tool_brief(name, b.get("input"))
                    self.tool_names[b.get("id")] = name
                    out.append(Item(ts, "tool", head, detail, sub, str(b.get("id")), name))
        elif typ == "user":
            content = (ev.get("message") or {}).get("content")
            if isinstance(content, str) and content.strip():
                out.append(Item(ts, "input", content, sub=sub))
            for b in content if isinstance(content, list) else []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "tool_result":
                    self.done_ids.add(str(b.get("tool_use_id")))
                    c = b.get("content")
                    if isinstance(c, list):
                        c = "\n".join(str(x.get("text", "")) for x in c if isinstance(x, dict))
                    lines = [ln.strip() for ln in str(c or "").splitlines() if ln.strip()]
                    head = lines[0] if lines else "(empty)"
                    more = f"  (+{len(lines) - 1} lines)" if len(lines) > 1 else ""
                    out.append(Item(ts, "result_err" if b.get("is_error") else "result", head + more, sub=sub,
                                    tool=self.tool_names.get(b.get("tool_use_id"), "")))
                elif b.get("type") == "text" and str(b.get("text") or "").strip():
                    out.append(Item(ts, "input", b["text"], sub=sub))
        elif typ == "result":
            bits = [str(ev.get("subtype") or "result") + (", error" if ev.get("is_error") else "")]
            if ev.get("num_turns") is not None:
                bits.append(f"turns {ev['num_turns']}")
            if isinstance(ev.get("total_cost_usd"), (int, float)):
                bits.append(f"${ev['total_cost_usd']:.2f}")
            if isinstance(ev.get("duration_ms"), (int, float)):
                bits.append(fmt_age(ev["duration_ms"] / 1000))
            out.append(Item(ts, "end", ", ".join(bits), str(ev.get("result") or "")))
        elif typ == "system" and ev.get("subtype") == "init":
            out.append(Item(ts, "init", "session start"))
        return out


# ---------------------------------------------------------------- collecting

class StageRef(NamedTuple):
    sid: str        # what agent-top calls the stage: its name, plus HOME_SEP and the home's label while homes are many
    name: str       # the stage's own name
    home: object    # hubcore.KnownHome


def home_stage_names(kh) -> list:
    """The stages of one home that agent-top lists: a directory with agents/ or a role registry."""
    try:
        return sorted(d.name for d in kh.path.iterdir() if d.is_dir() and hc.STAGE_RE.fullmatch(d.name)
                      and ((d / "agents").is_dir() or (d / "roles.json").exists()))
    except OSError:
        return []


def split_selector(raw: str) -> tuple:
    """(name, separator, qualifier) of a `--stage` value: `NAME`, `NAME@LABEL-or-PATH` or the displayed `NAME · LABEL`. A
    stage name has neither '@' nor ' · ', so whichever comes first ends the name and the rest (a label or a path may hold
    either) is the qualifier."""
    m = re.search(r"@| · ", raw)
    return (raw, "", "") if m is None else (raw[:m.start()], m.group(0), raw[m.end():])


def home_matches(kh, qual: str) -> bool:
    """Whether the qualifier of a `--stage name@qual` names the home: its label ("" is ~/agent-hub) or its path."""
    return kh.label == qual or ("/" in qual and hc.real_path(qual) == hc.real_path(kh.path))


def discover_stages(only, show_all: bool = False) -> tuple:
    """(stages to show as StageRef, ids of the closed stages left out, homes with stages): every stage with agents or a
    role registry in any known home (hubcore.known_homes), or the ones named (by name: in every home that has one; by
    `name@label`, `name@/path/of/home` or the displayed `name · label`: that home's); a stage closed by `hub close` only with --all or by name. A stage is its
    home's and name: two homes may each have a stage of one name."""
    per = [(kh, home_stage_names(kh)) for kh in hc.known_homes()]
    multi = sum(1 for _, names in per if names) > 1

    def ref(kh, name):
        return StageRef(f"{name}{HOME_SEP}{kh.label}" if multi and kh.label else name, name, kh)

    if only:
        out = []
        for raw in only:
            name, sep, qual = split_selector(raw)
            hit = [ref(kh, name) for kh, _ in per if (kh.path / name).is_dir() and (not sep or home_matches(kh, qual))]
            if not hit:   # not found anywhere: the resolved home's (empty) stage, as before
                hit = [ref(per[0][0], name)] if not sep else []
                with hc.in_home(per[0][0].path, per[0][0].layer):
                    hc.check_stage(name)
            for r in hit:
                if r not in out:
                    out.append(r)
        return out, [], multi
    refs = [ref(kh, n) for kh, names in per for n in names]
    if show_all:
        return refs, [], multi
    closed = []
    for r in refs:
        with hc.in_home(r.home.path, r.home.layer):
            if hc.stage_closed(r.name):
                closed.append(r.sid)
    return [r for r in refs if r.sid not in closed], closed, multi


def stage_activity(ref: StageRef):
    """The mtime of the stage's newest journal file, agent log, roles.json or questions.md; None when there is none."""
    base = ref.home.path / ref.name
    with hc.in_home(ref.home.path, ref.home.layer):
        work = hc.work_dir(ref.name)
    paths = [base / "roles.json", base / "questions.md", *work.glob("journal-*.md"),
             *base.glob("agents/*/log.jsonl")]
    newest = None
    for p in paths:
        try:
            m = p.stat().st_mtime
        except OSError:
            continue
        newest = m if newest is None else max(newest, m)
    return newest


def stage_info(ref: StageRef, agents: list, now: float) -> dict:
    """What the stage is and whether it is still in use: goal, closed record, live agents, last activity, idle; and where
    it lives (name, home, home_label)."""
    with hc.in_home(ref.home.path, ref.home.layer):
        closed, goal = hc.stage_closed(ref.name), hc.stage_goal(ref.name)
    at = stage_activity(ref)
    live = sum(1 for a in agents if a["stage"] == ref.sid and a["state"] == "live")
    idle_s = None if at is None else max(0, int(now - at))
    return {"goal": goal, "closed": closed, "live": live,
            "last_activity_at": None if at is None else dt.datetime.fromtimestamp(at, hc.TZ).isoformat(timespec="seconds"),
            "idle_s": idle_s, "idle": not closed and live == 0 and (idle_s is None or idle_s >= IDLE_S),
            "name": ref.name, "home": str(ref.home.path), "home_label": ref.home.label}


def load_ask():
    """bin/ask as a module: `ask summary` and `ask list --open` in-process (a subprocess costs an interpreter start)."""
    loader = importlib.machinery.SourceFileLoader("ask_register", str(BIN / "ask"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("ask_register", loader))
    sys.modules["ask_register"] = mod  # dataclasses look the module up while the class is built
    loader.exec_module(mod)
    return mod


class External:
    """`ask summary` / `ask list` results, refreshed in a thread so a slow register never freezes the screen."""
    TTL = 20.0
    _mod = None

    def __init__(self):
        self.data, self.at, self.busy = {}, 0.0, False
        self.ok = False  # True only when the last `ask summary` succeeded: {} then means "no registers", not "ask failed"
        self.thread = None

    def poll(self, stages: list, wait: bool = False) -> dict:
        """`stages`: StageRef of the shown stages; the answer is keyed by their ids."""
        """Starts a refresh when the last one is older than TTL; `wait` waits for the one in flight (a snapshot
        starts it early and waits at its end, so the registers are read while the logs are)."""
        if not self.busy and time.monotonic() - self.at > self.TTL:
            self.busy = True
            self.thread = threading.Thread(target=self._fetch, args=(list(stages),), daemon=True)
            self.thread.start()
        if wait and self.thread is not None:
            self.thread.join(30)
        return self.data

    def _fetch(self, stages: list) -> None:
        try:
            out, ok = {}, True
            homes = list(dict.fromkeys((r.home.path, r.home.layer) for r in stages))
            for path, layer in homes:             # one register per home: `ask` reads the home it is pointed at
                mine = {r.name: r.sid for r in stages if r.home.path == path}
                with hc.in_home(path, layer):
                    r = self._ask(["summary"], path)
                    ok = ok and r is not None
                    got = {}
                    for ln in (r or "").splitlines():
                        m = ASK_LINE_RE.match(ln)
                        if m and m.group(1) in mine:
                            got[m.group(1)] = {"open": int(m.group(2)), "overdue": int(m.group(3)), "line": ln.strip(),
                                               "items": [], "ids": []}
                    for name, q in got.items():
                        if q["open"]:
                            lst = self._ask(["list", "--stage", name, "--open"], path)
                            q["items"] = [ln.rstrip() for ln in (lst or "").splitlines() if ln.strip()][:12]
                            # `items` are display lines cut to 12; `ids` are all open question ids of the untruncated output
                            # (None: the list failed and the set is unknown), so a consumer diffs sets, not truncated text.
                            q["ids"] = None if lst is None else [m.group(1) for m in map(QUESTION_ID_RE.match, lst.splitlines()) if m]
                for name, q in got.items():
                    out[mine[name]] = q
            self.ok = ok
            self.data = out
        finally:
            self.at, self.busy = time.monotonic(), False

    @classmethod
    def _ask(cls, args: list, path=None):
        """stdout of `ask summary` / `ask list --stage S --open` in the home `path`, or None when it fails (an
        unreadable register)."""
        try:
            if cls._mod is None:
                cls._mod = load_ask()
            if path is not None:
                cls._mod.ROOT = Path(path)       # the register's home (ask resolves it once, at import)
            return cls._mod.summary_text() if args == ["summary"] else cls._mod.open_text(args[2])
        except BaseException:  # noqa: BLE001 — `ask` exits on a bad register; that is "unknown", not a crash
            return None


def open_store(kh=None):
    """The disk cache of one home's readers (bin/topcache.py), dropped whenever one of the modules that fill it changes; a
    store that keeps nothing when the hub home does not exist (agent-top never creates one). `kh`: a hubcore.KnownHome
    (default: the resolved home)."""
    path, layer = (kh.path, kh.layer) if kh is not None else (hc.root(), hc.home().layer)
    if not path.is_dir():
        return topcache.Null()
    here = Path(__file__).resolve()
    mods = [here] + [BIN / m for m in ("subagents.py", "codex_rollouts.py", "engines.py", "topcache.py")]
    with hc.in_home(path, layer):
        cache = hc.state_dir() / "agent-top" / "cache.sqlite"
    return topcache.Store(cache, topcache.code_signature(*map(str, mods), extra=f"scan_max={SCAN_MAX}"))


class Collector:
    def __init__(self, stages_arg, show_all: bool, stale_s: int = STALE_S):
        self.stages_arg, self.show_all, self.stale_s = stages_arg, show_all, stale_s
        self.logs, self.journal_cache = {}, {}
        self.transcripts, self.transcript_paths = {}, {}
        self.where: dict = {}                 # stage id -> StageRef of the last snapshot
        self.homes = hc.known_homes()
        self.stores: dict = {}                # one cache per home (one, when $AGENT_HUB_STATE_DIR puts every home's in one file)
        self._caches: dict = {}
        for kh in self.homes:
            store = open_store(kh)
            self.stores[str(kh.path)] = self._caches.setdefault(self._cache_key(store), store)
        # what is not a home's own (sub-agent transcripts, Codex rollouts) goes to the first existing home's cache
        self.store = next((self.stores[str(kh.path)] for kh in self.homes if kh.path.is_dir()), topcache.Null())
        self.flushed_at = time.monotonic()
        codex_rollouts.INDEX.store = self.store
        self.subs = subagents.Finder(lambda log: self.log_state(log).last_user_ts, self.store)
        self.ext = External()
        self.codex_limits = codex_limits.Reader()
        self.feed = None

    # -- agents
    @staticmethod
    def _cache_key(store):
        return getattr(store, "path", None) or id(store)

    def store_of(self, path: Path):
        """The cache of the home a log lies in; the shared one for a log outside every home."""
        for kh in self.homes:
            if kh.path in path.parents:
                return self.stores[str(kh.path)]
        return self.store

    def flush(self) -> None:
        for store in {id(x): x for x in [self.store, *self.stores.values()]}.values():
            store.flush()

    def log_state(self, path: Path) -> LogState:
        """The log's reader: this process's, else resumed from the disk cache, else new; then brought up to date."""
        st = self.logs.get(path)
        store = self.store_of(path)
        if st is None:
            st = self.logs[path] = LogState(path)
            topcache.load_into(st, store.get("log", str(path)), {"rollout": codex_rollouts.Normalizer})
        before = (st.ino, st.offset)
        st.update()
        if (st.ino, st.offset) != before:
            store.put("log", str(path), st)
            if time.monotonic() - self.flushed_at > FLUSH_S:
                self.flush()                # a first run killed by its caller's timeout still leaves what it read
                self.flushed_at = time.monotonic()
        return st

    def snapshot(self, wait_ext: bool = False) -> dict:
        now = time.time()
        ps = subagents.process_table_start()     # `ps` runs while the registers and the role files are read
        refs, closed_hidden, multi = discover_stages(self.stages_arg, self.show_all)
        self.where = {r.sid: r for r in refs}
        stages = [r.sid for r in refs]
        self.ext.poll(refs)
        agents, roles_by_stage, rate = [], {}, None
        for r in refs:
            try:
                with hc.in_home(r.home.path, r.home.layer):
                    roles_by_stage[r.sid] = hc.roles_load(r.name)["roles"]
            except hc.Failure:
                roles_by_stage[r.sid] = {}
        codex_rollouts.INDEX.update()
        table = subagents.process_table_finish(ps)
        live = live_sessions(table)
        for r in refs:
            stage = r.sid
            reg = {"roles": roles_by_stage[stage]}
            base = r.home.path / r.name / "agents"
            mine = []
            for mp in sorted(base.glob("*/meta.json")) if base.is_dir() else []:
                info = self._agent(stage, mp, reg["roles"], table, now)
                if info:
                    mine.append(info)
                    rt = info.pop("_rate")
                    if rt and (rate is None or rt[1] > rate[1]):
                        rate = rt
            mine += self._native_sessions(stage, reg["roles"], base, table, live, now)
            mine += self._subagents(stage, reg["roles"], table, live, now)
            for info in mine:   # where the stage lives, for a consumer that has to act on it (the stage id is not its name)
                info.update(stage_name=r.name, home=str(r.home.path), home_label=r.home.label)
            agents += mine
        agents.sort(key=lambda a: (a["group"], a["stage"], a["role"], a["dir_name"]))
        counts = {k: sum(1 for a in agents if a["state"] == k) for k in ("live", "done", "error", "dead")}
        # Keep the legacy four-key JSON shape when no new native state is present.
        for key in ("unknown", "stopped"):
            count = sum(1 for a in agents if a["state"] == key)
            if count:
                counts[key] = count
        locks = self._locks(now, refs)
        roles = {s: self._roles(s, rs, agents, now) for s, rs in roles_by_stage.items()}
        costs = {s: self._stage_costs(self.where[s], rs) for s, rs in roles_by_stage.items()}   # reads every log of the stage first:
        rates = self.token_rates()                                                  # prices must not depend on the list's filter
        spend = {s: self._spend(rs, rates, *costs[s]) for s, rs in roles_by_stage.items()}
        out = {"generated_at": dt.datetime.fromtimestamp(now, hc.TZ).isoformat(timespec="seconds"), "now": now,
               "stages": stages, "closed_hidden": closed_hidden, "idle_after_s": IDLE_S,
               "homes": [{"path": str(kh.path), "label": kh.label, "layer": kh.layer, "repo": kh.repo,
                          "stages": [r.sid for r in refs if r.home == kh]} for kh in self.homes],
               "multi_home": multi,
               "stage_info": {r.sid: stage_info(r, agents, now) for r in refs}, "agents": agents, "counts": counts, "locks": locks, "roles": roles, "spend": spend,
               "questions": self.ext.poll(refs, wait=wait_ext), "questions_ok": self.ext.ok,
               "limits": ({"info": rate[0], "seen_at": rate[1]} if rate else None),
               "codex_limits": self.codex_limits.snapshot()}
        self.flush()
        return out

    def _agent(self, stage: str, meta_path: Path, registry: dict, table, now: float):
        meta = read_json(meta_path)
        if not isinstance(meta, dict):
            return None
        d = meta_path.parent
        m = ARCHIVE_RE.match(d.name)
        archived = bool(m)
        alive = is_alive(meta, table)
        log = d / "log.jsonl"
        try:
            mtime = log.stat().st_mtime
        except OSError:
            mtime = None
        if not self.show_all and (archived or (meta.get("engine") != "codex" and
                not alive and (mtime is None or now - mtime > RECENT_S))):
            return None
        ls = self.log_state(log)
        event_at = ls.last_event_ts if ls.native_rollout else mtime
        if not self.show_all and (archived or (not alive and (event_at is None or now - event_at > RECENT_S))):
            return None
        res = ls.last_result
        if alive:
            state = "live"
        elif res and not ls.running:
            state = "error" if (res.get("is_error") or res.get("subtype") != "success") else "done"
        else:
            state = "dead"
        age = None if event_at is None else max(0, now - event_at)
        unread = [u for u in meta.get("inbox_unread") or []
                  if isinstance(u, dict) and max(ls.inbox_touch, ls.done_at) < num(u.get("log_offset"))]
        act = ls.action() if alive else None
        role = meta.get("role") or (m.group("role") if m else d.name)
        return {
            "kind": "headless", "parent": None,
            "engine": meta.get("engine") or ls.engine,
            "stage": stage, "role": role, "dir_name": d.name, "tag": meta.get("tag") or role,
            "title": meta.get("title") or "", "model": meta.get("model") or "", "effort": meta.get("effort"),
            "model_id": meta.get("resolved_model") or ls.model,
            "ctx_window": ls.ctx_window(meta.get("resolved_model") or ls.model or meta.get("model")),
            "state": state, "group": {"live": 0, "dead": 1, "error": 1, "done": 2}[state],
            "quiet": bool(alive and age is not None and age > self.stale_s),
            "alive": alive, "pid": meta.get("pid"), "session_id": meta.get("session_id"),
            "retired": d.name not in registry, "archived": archived,
            "age_s": None if age is None else int(age),
            "last_event_at": None if event_at is None else dt.datetime.fromtimestamp(event_at, hc.TZ).isoformat(timespec="seconds"),
            "started_at": meta.get("started_at"), "runs": len(meta.get("runs") or []),
            "turns": ls.turns, "run_turns": ls.run_turns, "sub_turns": ls.sub_turns, "turns_approx": ls.truncated,
            "ctx_tokens": ls.ctx or None,
            "ctx_source": ls.ctx_source, "context_window": ls.context_window,
            "usage_tokens": ls.usage_tokens, "usage_scope": ls.usage_scope, "codex_rate_limits": ls.codex_rate_limits,
            "turns_kind": "user" if ls.engine == "codex" else "model",
            "cost_usd": None if ls.cost_sum is None else round(ls.cost_sum, 4),
            "result": None if not res else {"subtype": res.get("subtype"), "is_error": bool(res.get("is_error")),
                                            "num_turns": res.get("num_turns"), "text": str(res.get("result") or (ls.last_text if ls.engine == "codex" else ""))[:400]},
            "action": None if not act else {"tool": act["tool"], "text": act["text"], "detail": act["detail"],
                                            "elapsed_s": None if not act["ts"] else max(0, int(now - act["ts"]))},
            "last_text": ls.last_text, "unread": [{"at": u.get("at"), "msg": u.get("msg")} for u in unread],
            "cwd": meta.get("cwd"), "log_path": str(log), "log_bytes": ls.size, "brief_path": str(d / "brief.md"),
            "inbox_path": str(d / "inbox.md"), "report_path": meta.get("report"),
            "_rate": (ls.rate, ls.rate_mtime) if ls.rate else None,
        }

    # -- sub-agents (read-only: only their parent session can message them; discovery and state: bin/subagents.py)
    def _native_sessions(self, stage, registry, base, table, live, now):
        out = []
        for role, rec in sorted(registry.items()):
            if (base / role / "meta.json").exists():
                continue  # managed workers already use the raw exec stream
            sid = rec.get("cli_session_id") or rec.get("session") or ""
            if not isinstance(sid, str) or not UUID_RE.fullmatch(sid):
                continue
            sub = self.subs.codex_session(sid, subagents.parent_alive(rec, sid, table, live), now, self.show_all)
            if sub:
                info = self._subagent(stage, role, rec, sub, now)
                info.update(kind="session", parent=None, role=role, dir_name=role,
                            title=rec.get("title") or "Codex session", agent_type=None, background=False,
                            cwd=sub.meta.get("cwd"), started_at=sub.meta.get("timestamp"),
                            liveness_source="completion" if sub.status else "unknown" if sub.state == "unknown" else "process")
                out.append(info)
        return out

    def _subagents(self, stage: str, registry: dict, table, live, now: float) -> list:
        out = []
        for prole, rec in sorted(registry.items()):
            sid = rec.get("cli_session_id") or rec.get("session") or ""
            if not isinstance(sid, str) or not UUID_RE.fullmatch(sid):
                continue
            for sub in self.subs.of_session(sid, subagents.parent_alive(rec, sid, table, live), now, self.show_all):
                out.append(self._subagent(stage, prole, rec, sub, now))
        return out

    def _subagent(self, stage: str, prole: str, prec: dict, sub, now: float):
        ls = self.log_state(sub.log)
        aid, mtime, status, state = sub.aid, sub.mtime, sub.status, sub.state
        alive = state == "live"
        event_at = sub.last_event_ts if sub.meta.get("engine") == "codex" else mtime
        age = sub.age(now)
        act = ls.action() if alive else None
        desc = sub.description
        meta = sub.meta
        terminal_text = str((ls.last_result or {}).get("result") or ls.last_text)
        return {
            "kind": "subagent", "parent": prole,
            "engine": meta.get("engine") or ls.engine,
            "stage": stage, "role": f"{prole}/{aid[:7]}", "dir_name": f"{prole}/{aid}",
            "tag": prec.get("tag") or prole, "title": desc or str(meta.get("agentType") or "sub-agent"),
            "model": str(meta.get("model") or ""), "model_id": ls.model, "effort": ls.effort,
            "ctx_window": ls.ctx_window(ls.model or meta.get("model")),
            "state": state, "group": {"live": 0, "unknown": 0, "dead": 1, "error": 1, "stopped": 2, "done": 2}[state],
            "quiet": bool(alive and age is not None and age > self.stale_s),
            "alive": alive, "expired": sub.expired, "handoff_blocking": sub.unresolved, "pid": None, "session_id": aid, "retired": False, "archived": False,
            "age_s": None if age is None else int(age),
            "last_event_at": None if event_at is None else dt.datetime.fromtimestamp(event_at, hc.TZ).isoformat(timespec="seconds"),
            "started_at": None, "runs": 1,
            "turns": ls.turns, "run_turns": ls.turns, "sub_turns": 0, "turns_approx": ls.truncated,
            "ctx_tokens": ls.ctx or None,
            "ctx_source": ls.ctx_source, "context_window": ls.context_window,
            "usage_tokens": ls.usage_tokens, "usage_scope": ls.usage_scope, "codex_rate_limits": ls.codex_rate_limits,
            "turns_kind": "user" if ls.engine == "codex" else "model",
            "cost_usd": None,
            "result": None if status is None else {"subtype": status, "is_error": state == "error", "num_turns": None,
                                                   "text": terminal_text[:400]},
            "action": None if not act else {"tool": act["tool"], "text": act["text"], "detail": act["detail"],
                                            "elapsed_s": None if not act["ts"] else max(0, int(now - act["ts"]))},
            "last_text": ls.last_text, "unread": [],
            "cwd": None, "log_path": str(sub.log), "log_bytes": ls.size, "brief_path": "", "inbox_path": "",
            "report_path": None, "agent_type": meta.get("agentType"), "background": sub.background,
        }

    # -- spend of a stage: its agents (logged dollars) and its hub (an estimate from the hub's transcript)
    def token_rates(self) -> dict:
        """model -> dollars per weighted token, as observed in the `modelUsage` of the agents' latest results."""
        cost, tokens = {}, {}
        for ls in self.logs.values():
            for model, u in (ls.model_usage or {}).items() if isinstance(ls.model_usage, dict) else []:
                dollars = u.get("costUSD") if isinstance(u, dict) else None
                if isinstance(dollars, (int, float)) and dollars > 0:      # (num() would truncate 1.5 to 1)
                    cost[model] = cost.get(model, 0.0) + dollars
                    tokens[model] = tokens.get(model, 0.0) + weighted_tokens(u, snake=False)
        return {m: cost[m] / tokens[m] for m in cost if tokens[m] > 0}

    def transcript(self, sid: str):
        """The reader of a session's transcript, brought up to date (at most SCAN_MAX bytes per call), or None."""
        path = self.transcript_paths.get(sid)
        if path is None or not path.exists():
            found = sorted(subagents.projects_root().glob(f"*/{sid}.jsonl"))
            path = self.transcript_paths[sid] = found[0] if found else None
            if path is None:
                return None
        tr = self.transcripts.get(path)
        if tr is None:
            tr = self.transcripts[path] = Transcript(path)
            topcache.load_into(tr, self.store.get("transcript", str(path)))
        before = (tr.ino, tr.offset)
        tr.update(SCAN_MAX)
        if (tr.ino, tr.offset) != before:
            self.store.put("transcript", str(path), tr)
        return tr

    def _stage_costs(self, ref: StageRef, roles: dict) -> tuple:
        """(the hub's logged dollars or None, the other agents' logged dollars) over every agent folder of the stage:
        what the list hides by age or archive is spend all the same. Only Claude headless logs carry dollars (a Codex
        agent adds nothing). The hub's are those of the agent registered as the hub's session, when it is a headless one
        too; a predecessor's archived folder is an agent like the others."""
        rec = roles.get("hub") or {}
        hub_sids = {v for v in (rec.get("cli_session_id"), rec.get("session")) if isinstance(v, str) and v}
        hub_cost, agents_usd, base = None, 0.0, ref.home.path / ref.name / "agents"
        for mp in sorted(base.glob("*/meta.json")) if base.is_dir() else []:
            meta = read_json(mp)
            if not isinstance(meta, dict):
                continue
            cost = self.log_state(mp.parent / "log.jsonl").cost_sum
            if meta.get("session_id") in hub_sids and not ARCHIVE_RE.match(mp.parent.name) and cost is not None:
                hub_cost = cost
            elif cost is not None:
                agents_usd += cost
        return hub_cost, agents_usd

    def _spend(self, roles: dict, rates: dict, hub_cost, agents_usd: float) -> dict:
        """{"hub_usd", "hub_basis", "hub_partial", "agents_usd", "hub_share"} of one stage. The hub's dollars are the
        logged ones, else an estimate from the tokens in the hub's transcript; None when neither exists."""
        rec = roles.get("hub") or {}
        out = {"hub_usd": None, "hub_basis": None, "hub_partial": False, "agents_usd": round(agents_usd, 4), "hub_share": None}
        sid = rec.get("cli_session_id") or rec.get("session") or ""
        if hub_cost is not None:
            out.update(hub_usd=round(hub_cost, 4), hub_basis="logged")
        elif rec.get("engine", "claude") == "claude" and isinstance(sid, str) and UUID_RE.fullmatch(sid):
            tr = self.transcript(sid)
            if tr is not None:
                totals = tr.totals()
                priced = {m: u for m, u in totals.items() if m in rates}
                if priced:
                    est = sum(weighted_tokens(u, snake=True) * rates[m] for m, u in priced.items())
                    out.update(hub_usd=round(est, 4), hub_basis="estimate", hub_partial=not tr.complete or len(priced) < len(totals))
        if out["hub_usd"] is not None and out["hub_usd"] + agents_usd > 0:
            out["hub_share"] = round(out["hub_usd"] / (out["hub_usd"] + agents_usd), 4)
        return out

    # -- locks / roles
    def _locks(self, now: float, refs: list) -> list:
        """The lock boards of the resolved home and of every home whose stages are shown (a board is per home), each lock
        with its home; $AGENT_BOARD_FILE, the one board the owner pointed everything at, is read once, as the resolved home's."""
        import board
        homes = list(dict.fromkeys([self.homes[0]] + [r.home for r in refs]))
        explicit = os.environ.get("AGENT_BOARD_FILE")
        out, saved, seen = [], board.BOARD, set()
        try:
            for kh in homes[:1] if explicit else homes:
                board.BOARD = Path(explicit) if explicit else kh.path / "board.md"
                real = hc.real_path(board.BOARD)
                if real in seen:      # two homes whose boards are one file (a symlink): its locks once, under the first home
                    continue
                seen.add(real)
                try:
                    recs = board.load()
                except (board.BoardError, ValueError, OSError):
                    continue
                at = board.now()
                out += [{"kind": r["kind"], "repo": r.get("repo") or board.DEFAULT_REPO, "owner_name": r.get("owner_name") or "?",
                         "until": r["until"], "active": board.is_active(r, at), "why": r.get("why") or "",
                         "value": r.get("value") or "", "home": str(kh.path), "home_label": kh.label} for r in recs]
        finally:
            board.BOARD = saved
        return out

    def _roles(self, stage: str, roles: dict, agents: list, now: float) -> list:
        ref = self.where[stage]
        lines = self.journal_lines(stage, 1) + self.journal_lines(stage, 0)   # oldest first: today's lines are met first from the end
        newest = {}   # base tag -> its newest line: what hc.tag_is(line tag, base) finds first from the end
        for day_off, hhmm, t, _ in reversed(lines):
            if not t:
                continue
            for c in {t, *t.split()[:1]}:
                parts = c.split("/")
                for i in range(1, len(parts) + 1):
                    newest.setdefault("/".join(parts[:i]), (day_off, hhmm))
        out = []
        with hc.in_home(ref.home.path, ref.home.layer):
            goal = hc.title_goal(hc.stage_goal(ref.name))
        for name, rec in roles.items():
            tag = rec.get("tag") or name
            title = rec.get("title") or ""
            if name == "hub" and goal and goal not in title:  # a hub registered before the goal was set, or by --name
                title = f"{title} — {goal}" if title else goal
            last = None
            if tag in newest:
                day_off, hhmm = newest[tag]
                hh, mm = map(int, hhmm.split(":"))
                day = hc.now().date() - dt.timedelta(days=day_off)
                last = dt.datetime.combine(day, dt.time(hh, mm), tzinfo=hc.TZ).timestamp()
            ag = next((a for a in agents if a["stage"] == stage and a["dir_name"] == name), None)
            out.append({"role": name, "kind": rec.get("kind"), "tag": tag, "title": title,
                        "pid": rec.get("pid"), "state": ag["state"] if ag else None,
                        "journal_age_s": None if last is None else max(0, int(now - last))})
        out.sort(key=lambda r: (r["role"] != "hub", r["role"]))
        return out

    # -- journal
    def journal_lines(self, stage: str, day_off: int) -> list:
        """[(day_off, "HH:MM", tag, text)] of one day's journal of the stage; re-read only when the file changed."""
        ref = self.where[stage]
        with hc.in_home(ref.home.path, ref.home.layer):
            path = hc.journal_path(ref.name, hc.now().date() - dt.timedelta(days=day_off))
        try:
            st = os.stat(path)
        except OSError:
            return []
        sig = (st.st_size, st.st_mtime)
        cached = self.journal_cache.get(path)
        if cached and cached[0] == sig:
            return cached[1]
        lines = []
        try:
            with open(path, "rb") as fh:
                if st.st_size > 400_000:
                    fh.seek(st.st_size - 400_000)
                    fh.readline()
                raw = fh.read().decode("utf-8", "replace")
        except OSError:
            return []
        for ln in raw.splitlines():
            p = hc.parse_journal_line(ln)
            if p:
                lines.append((day_off, p[0], p[1], p[2]))
        self.journal_cache[path] = (sig, lines)
        return lines

    def journal(self, stages: list, day_off: int = 0) -> list:
        """Merged lines of the stages for one day: [(stage, "HH:MM", tag, text)] in time order."""
        merged = []
        for s in stages:
            merged += [(s, hh, tag, text) for _, hh, tag, text in self.journal_lines(s, day_off)]
        merged.sort(key=lambda r: (int(r[1].split(":")[0]) * 60 + int(r[1].split(":")[1])))
        return merged


def find_agent(snap: dict, name: str):
    """An agent by dir name or role: the live one, else the freshest entry that is not archived."""
    cands = [a for a in snap["agents"] if name in (a["dir_name"], a["role"])]
    cands.sort(key=lambda a: (a["archived"], a["group"]))
    return cands[0] if cands else None


# ---------------------------------------------------------------- rendering: rows are lists of (text, style)

GLYPH = {"live": ("●", "live"), "done": ("✓", "done"), "error": ("✗", "err"), "dead": ("✗", "err"),
         "unknown": ("?", "warn"), "stopped": ("■", "dim")}
WORD = {"live": "live", "done": "done", "error": "error", "dead": "died", "unknown": "unknown", "stopped": "stopped"}


class Row:
    __slots__ = ("segs", "fill")

    def __init__(self, segs, fill=None):
        self.segs, self.fill = segs, fill

    def text(self) -> str:
        return "".join(t for t, _ in self.segs)

    def fit(self, width: int) -> "Row":
        """The same row cut to `width` display cells."""
        segs, used = [], 0
        for t, st in self.segs:
            t = clip(t, width - used, ellipsis=False)
            segs.append((t, st))
            used += dispw(t)
        return Row(segs, self.fill)


def R(*segs, fill=None) -> Row:
    return Row([s if isinstance(s, tuple) else (s, "norm") for s in segs], fill)


def wrap_rows(text: str, width: int, style: str = "norm", first: str = "", rest: str = "", max_lines: int = 0) -> list:
    return [R((ln, style)) for ln in wrap(text, width, first, rest, max_lines)]


def action_text(a: dict) -> str:
    act = a["action"]
    if not act:
        return ""
    el = act["elapsed_s"]
    return f"▸ {tool_label(act['tool'])}: {act['text']}" + (f"  ({fmt_age(el)})" if el and el >= 10 else "")


def what_now(a: dict) -> tuple:
    """(text, style) for the last column of the list."""
    if a["alive"]:
        if a["action"]:
            return action_text(a), "norm"
        return ("⋯ " + a["last_text"] if a["last_text"] else "⋯ thinking"), "dim"
    if a["result"] and a["state"] in ("done", "error", "stopped"):
        return (a["last_text"] or a["result"]["text"] or a["result"]["subtype"] or ""), "dim"
    if a.get("expired"):
        return "unknown observation expired; no death/completion evidence; not blocking handoff", "dim"
    if a.get("kind") == "session":
        return (a["last_text"] or "no completed turn — session process is unknown"), "dim"
    if a.get("kind") == "subagent":
        return (a["last_text"] or "no completion notice — its parent session ended or it was stopped"), "dim" if a["last_text"] else "err"
    return (a["last_text"] or "no process, no result — died or was killed"), ("dim" if a["last_text"] else "err")


def header_row(snap: dict, width: int, view_label: str) -> Row:
    c = snap["counts"]
    locks = sum(1 for lk in snap["locks"] if lk["active"])
    q_open = sum(q["open"] for q in snap["questions"].values())
    q_over = sum(q["overdue"] for q in snap["questions"].values())
    title = " Delamain · agent-top " if width >= 60 else " agent-top "
    bits = [(title, "head_b"), (f"● {c['live']} ", "head_live"), (f"✓ {c['done']} ", "head"),
            (f"✗ {c['error'] + c['dead']} ", "head_err" if c["error"] + c["dead"] else "head")]
    if c.get('unknown'):
        bits.append((f"? {c['unknown']} ", "head"))
    if c.get('stopped'):
        bits.append((f"■ {c['stopped']} ", "head"))
    if view_label:
        bits.append((view_label + " ", "head_b"))
    # optional pieces, dropped from the end when the terminal is narrow
    opt = [(f"{'/'.join(snap['stages']) or '—'} ", "head"), (f"· locks {locks} ", "head"),
           (f"· questions {q_open}" + (f" (overdue {q_over})" if q_over else "") + " ", "head_err" if q_over else "head")]
    claude_limit, codex_limit = [], []
    lim = snap.get("limits")
    if lim and isinstance(lim["info"], dict):
        w = lim["info"].get("unifiedWindows") or {}
        parts = [f"{lab} {pct(w[k])}" for k, lab in (("five_hour", "5h"), ("seven_day", "7d")) if isinstance(w.get(k), dict)]
        if parts:
            claude_limit.append(("· Claude " + " ".join(parts) + " ", "head"))
    for lid, record in sorted(snap.get("codex_limits", {}).items()):
        parts = [f"{w['label']} {w['used_percent']:g}%" for w in codex_limits.windows(record["info"])]
        if parts:
            label = "Codex" if lid == "codex" else f"Codex {one_line(lid)}"
            codex_limit.append((f"· {label} " + " ".join(parts) + " ", "head"))
    # Account usage remains visible before stage/lock/question details in a
    # narrow terminal; all values remain available on the summary screen.
    opt = codex_limit + claude_limit + opt
    clock = dt.datetime.fromtimestamp(snap["now"], hc.TZ).strftime("%H:%M:%S") + " "
    while opt and sum(dispw(t) for t, _ in bits + opt) + dispw(clock) > width:
        opt.pop()
    bits += opt
    fillw = max(0, width - sum(dispw(t) for t, _ in bits) - dispw(clock))
    return Row(bits + [(" " * fillw, "head"), (clock, "head")], fill="head")


def list_layout(width: int, multi: bool, turns_w: int = 5, stage_w: int = 8) -> list:
    """Columns [(name, width)] that fit; the last text column takes what is left. turns_w: the TURN column grows when
    a resumed agent shows "last run/total"."""
    cols = [("glyph", 2), ("role", 10)]
    if multi:
        cols.insert(1, ("stage", stage_w))
    optional = [("state", 7, 90), ("tag", 15, 122), ("model", 14, 100), ("age", 6, 0), ("turns", turns_w, 0),
                ("ctx", 5, 78), ("cost", 6, 96), ("unread", 3, 60)]
    for name, w, min_w in optional:
        if width >= min_w:
            cols.append((name, w))
    # The task (meta title) says what the agent is for; the role name alone does not. It takes a share
    # of what is left and splits it evenly with the "now" column.
    rest = width - sum(w for _, w in cols)
    if rest >= 32:
        cols.insert(cols.index(("role", 10)) + 1, ("task", min(44, rest // 2)))
    return cols


def rj(s: str, w: int) -> str:
    """Right-aligned in w-1 cells plus a gap."""
    s = clip(s, w - 1, ellipsis=False)
    return " " * (w - 1 - dispw(s)) + s + " "


def task_text(a: dict) -> str:
    """The agent's title without the trailing "(tag)" that `agent spawn` appends: the tag has its own column."""
    t = one_line(a["title"] or "")
    tag = a["tag"] or ""
    if tag and t.endswith(f"({tag})"):
        t = t[: -len(tag) - 2].rstrip()
    return t or "—"


def cell(a: dict, name: str, w: int):
    if name == "glyph":
        g, st = GLYPH[a["state"]]
        return g + " ", ("warn" if a["quiet"] else st)
    if name == "stage":
        return pad(a["stage"], w), "dim"
    if name == "role":
        return pad(a["role"] + ("*" if a["archived"] else ""), w), "bold"
    if name == "state":
        return pad("quiet" if a["quiet"] else WORD[a["state"]], w), ("warn" if a["quiet"] else GLYPH[a["state"]][1])
    if name == "tag":
        return pad(a["tag"], w), "dim"
    if name == "task":
        return pad(clip(task_text(a), w - 1), w), "norm"
    if name == "model":
        return pad(model_label(a), w), "dim"
    if name == "age":
        return rj(fmt_age(a["age_s"]), w), ("warn" if a["quiet"] else "norm")
    if name == "turns":
        return rj(turns_label(a), w), "norm"
    if name == "ctx":
        return rj(fmt_k(a["ctx_tokens"]), w), "dim"
    if name == "cost":
        return rj(fmt_cost(a["cost_usd"]), w), "dim"
    if name == "unread":
        return pad(f"✉{len(a['unread'])}" if a["unread"] else "", w), "warn"
    return " " * w, "norm"


def list_head_row(cols: list, width: int) -> Row:
    titles = {"glyph": "", "stage": "STAGE", "role": "ROLE", "task": "TASK", "state": "STATUS", "tag": "TAG", "model": "MODEL",
              "age": "AGE", "turns": "TURN", "ctx": "CTX", "cost": "$", "unread": "✉"}
    segs = []
    for name, w in cols:
        t = titles[name]
        segs.append((rj(t, w) if name in ("age", "turns", "ctx", "cost") else pad(t, w), "dim_u"))
    used = sum(w for _, w in cols)
    segs.append((pad("NOW / LAST", max(0, width - used)), "dim_u"))
    return Row(segs, fill="dim_u")


def agent_row(a: dict, cols: list, width: int, selected: bool) -> Row:
    segs = [cell(a, name, w) for name, w in cols]
    used = sum(w for _, w in cols)
    text, st = what_now(a)
    segs.append((pad(one_line(text), max(0, width - used)), st))
    if selected:
        return Row([(t, "sel") for t, _ in segs], fill="sel")
    return Row(segs)


def detail_rows(a, width: int) -> list:
    """The pane under the list: the selected agent's title, current action, last thought, unread."""
    if not a:
        return []
    rows = [R(("─" * width, "dim"))]
    head = f" {a['role']} · {a['tag']} · {model_label(a)} · {WORD[a['state']]}" + \
           (f" pid {a['pid']}" if a["alive"] and a["pid"] else "") + f" · {fmt_age(a['age_s'])} ago"
    rows.append(R((clip(head, width), "bold")))
    if a["title"]:
        rows.append(R((clip(" " + a["title"], width), "dim")))
    if a["action"]:
        rows += wrap_rows(action_text(a), width, "live", " ", "   ", 2)
    if a["last_text"]:
        rows += wrap_rows(a["last_text"], width, "norm", " ✎ ", "   ", 3)
    if a["unread"]:
        u = a["unread"][0]
        rows += wrap_rows(f"✉ {len(a['unread'])} unread since {(u['at'] or '')[11:16]}: {u['msg']}", width, "warn", " ", "   ", 2)
    return rows


def agent_key(a: dict) -> tuple:
    """What an agent is, whatever the stage is called on screen: (its home, its stage's own name, its folder). The id
    `stage · label` depends on how many homes have stages, so a cursor, a confirmation or an action never holds it."""
    return (a.get("home") or "", a.get("stage_name") or a["stage"], a["dir_name"])


def list_rows(snap: dict, width: int, sel_key, height=None, detail: bool = True) -> tuple:
    """(rows, index of the selected agent row) for the list view; height=None — no windowing (--once)."""
    agents = snap["agents"]
    multi = len({a["stage"] for a in agents}) > 1
    stage_w = 8
    if snap.get("multi_home"):   # "stage · repo" ids are longer than a stage name
        stage_w = max(8, min(28, max([0] + [dispw(a["stage"]) + 1 for a in agents])))
    cols = list_layout(width, multi, max([5] + [dispw(turns_label(a)) + 1 for a in agents]), stage_w)
    rows = [list_head_row(cols, width)]
    if not agents:
        rows.append(R((" no agents (a — show all, including old ones)", "dim")))
        return rows, -1
    sel_i = next((i for i, a in enumerate(agents) if agent_key(a) == sel_key), 0)
    body = [agent_row(a, cols, width, i == sel_i and height is not None) for i, a in enumerate(agents)]
    dpane = detail_rows(agents[sel_i], width) if (detail and height is not None and height >= 16) else []
    if height is None:
        return rows + body, sel_i
    room = max(1, height - len(rows) - len(dpane))
    start = min(max(0, sel_i - room + 1), max(0, len(body) - room)) if sel_i >= room else 0
    visible = body[start:start + room]
    blank = [R(("", "norm"))] * (room - len(visible)) if dpane else []
    return rows + visible + blank + dpane, sel_i - start + len(rows)


def card_rows(a: dict, width: int) -> list:
    rows = []
    g, st = GLYPH[a["state"]]
    state = ("quiet " if a["quiet"] else "") + WORD[a["state"]] + (f" pid {a['pid']}" if a["alive"] and a["pid"] else "")
    rows.append(R((f" {g} ", st), (a["role"], "bold"), (f" · {a['stage']} · {model_label(a)} · ", "dim"),
                  (state, st), (f" · {fmt_age(a['age_s'])} ago", "warn" if a["quiet"] else "dim")))
    bits = [f"tag {a['tag']}", f"turns {turns_label(a, ' (total ')}{')' if a['run_turns'] != a['turns'] else ''}"
            + (f" (+{a['sub_turns']} sub-agent turns)" if a["sub_turns"] else ""), f"ctx {fmt_k(a['ctx_tokens'])}",
            f"$ {fmt_cost(a['cost_usd'])}", f"runs {a['runs']}"]
    rows += wrap_rows(" · ".join(bits), width, "dim", " ", "   ")
    if a.get("engine") == "codex":
        usage = a.get("usage_tokens") or {}
        rows += wrap_rows(f"Codex: user turns · input usage {'≈' if a.get('usage_scope') == 'partial' else ''}{fmt_k(usage.get('input_tokens'))} across model calls"
                          + (" · ctx is the last model input" if a.get("ctx_source") else " · context size unavailable"),
                          width, "dim", " ", "   ", 3)
    if a["title"]:
        rows += wrap_rows(a["title"], width, "dim", " ", "   ", 2)
    if a["cwd"]:
        rows.append(R((clip(" cwd " + tildify(a["cwd"]), width), "dim")))
    if a["action"]:
        rows += wrap_rows(action_text(a), width, "live", " ", "   ", 2)
    elif a["alive"]:
        rows.append(R((" ⋯ waiting for the model", "dim")))
    if a["state"] in ("done", "error", "stopped") and a["result"]:
        r = a["result"]
        rows += wrap_rows(f"result: {r['subtype']}{', error' if r['is_error'] else ''} — {one_line(r['text'])[:300]}", width,
                          "err" if r["is_error"] else "done", " ", "   ", 3)
    if a.get("kind") == "session":
        rows += wrap_rows("native Codex session; read-only here — continue it in Codex. "
                          "Without process or completion evidence, unfinished state is unknown.", width, "dim", " ", "   ", 3)
    elif a.get("kind") == "subagent":
        rows += wrap_rows(f"sub-agent of {a['parent']} ({a.get('agent_type') or '?'}, "
                          f"{'background' if a.get('background') else 'foreground'}); read-only here — only its parent "
                          f"session can message it ({'send_input' if a.get('engine') == 'codex' else 'SendMessage'} "
                          f"to {a['session_id']})", width, "dim", " ", "   ", 3)
        if a["state"] == "dead":
            rows.append(R((" no completion notice: its parent session ended or it was stopped", "err")))
    elif a["state"] == "dead":
        rows.append(R((" no process, no result — died or was killed; agent send without text resumes it", "err")))
    for u in a["unread"][:3]:
        rows += wrap_rows(f"✉ unread ({(u['at'] or '')[11:16]}): {u['msg']}", width, "warn", " ", "   ", 2)
    return rows


def feed_rows(feed: Feed, width: int, live: bool, now: float) -> list:
    rows = []
    tw = 9 if width >= 60 else 0
    for it in feed.items:
        t = (hhmmss(it.ts) + " ") if tw else ""
        t = t.ljust(tw)
        mark = "  ↳ " if it.sub else ""
        first, rest = t + mark, " " * (tw + len(mark))
        w = width
        if it.kind in ("text", "thinking"):
            ls = text_lines(it.text, 14)
            for i, ln in enumerate(ls):
                rows += wrap_rows(ln, w, "dim" if it.kind == "thinking" else "norm",
                                  (first + "✎ ") if i == 0 else rest + "  ", rest + "  ")
        elif it.kind == "tool":
            pending = it.tool_id not in feed.done_ids
            suffix = ""
            if pending and live and it.ts:
                suffix = f"  ⏳ {fmt_age(now - it.ts)}"
            rows += wrap_rows(f"{tool_label(it.tool)}: {it.text}{suffix}", w, "tool_p" if pending and live else "tool",
                              first + "▸ ", rest + "  ", 3)
            if it.detail:
                rows += wrap_rows(it.detail, w, "dim", rest + "  $ ", rest + "    ", 3)
        elif it.kind in ("result", "result_err"):
            rows += wrap_rows(it.text, w, "err" if it.kind == "result_err" else "dim", rest + "◂ ", rest + "  ", 2)
        elif it.kind == "input":
            for i, ln in enumerate(text_lines(it.text, 6)):
                rows += wrap_rows(ln, w, "warn", (first + "→ ") if i == 0 else rest + "  ", rest + "  ")
        elif it.kind == "end":
            rows += wrap_rows(f"end of run: {it.text}", w, "bold", first + "■ ", rest + "  ")
        elif it.kind == "init":
            rows += wrap_rows(it.text, w, "dim", first + "⚙ ", rest + "  ")
    if feed.truncated:
        rows.insert(0, R((clip(f"… showing only the log tail (last {FEED_TAIL_BYTES // 1000} KB)", width), "dim")))
    return rows or [R(("(log is empty)", "dim"))]


def brief_rows(path: str, width: int, unread_msgs=()) -> list:
    try:
        with open(path, "rb") as fh:
            raw = fh.read(300_000).decode("utf-8", "replace")
    except OSError:
        return [R(("(no such file)", "dim"))]
    rows = []
    for ln in raw.splitlines():
        ln = _CTRL_RE.sub(" ", ln).rstrip()
        st = "warn" if unread_msgs and any(m and m in ln for m in unread_msgs) else "norm"
        rows += wrap_rows(ln, width, st, "", "  ") if ln.strip() else [R(("", "norm"))]
    return rows


def journal_rows(lines: list, width: int, multi: bool, flt: str, tag_flt) -> tuple:
    rows, shown = [], 0
    f = flt.lower()
    sw = max([7] + [min(28, dispw(s)) for s, *_ in lines]) if any(HOME_SEP in s for s, *_ in lines) else 7
    for stage, hhmm, tag, text in lines:
        if tag_flt and not (hc.tag_is(tag, tag_flt) or hc.mentions(text, tag_flt)):
            continue
        if f and f not in f"[{tag}] {text}".lower():
            continue
        shown += 1
        lead = f"{hhmm} " + (f"{stage[:sw]:{sw}} " if multi else "")
        head = f"[{tag}] "
        body = wrap(text, width - dispw(lead) - dispw(head) if width > 50 else width, "", "")
        segs_first = [(lead, "dim"), (head, tag_style(tag))]
        rows.append(Row(segs_first + [(clip(body[0], max(0, width - dispw(lead) - dispw(head))), "norm")]))
        indent = " " * (dispw(lead) + 2)
        for ln in body[1:]:
            rows.append(R((indent + ln, "norm")))
    return rows, shown


def tag_style(tag: str) -> str:
    return "tag%d" % (sum(ord(c) for c in tag.split("/")[0]) % 6)


def spend_text(sp: dict) -> str:
    """One line: what the stage's agents cost and the hub's share of it (≈ marks an estimate from tokens)."""
    hub, agents = sp.get("hub_usd"), sp.get("agents_usd") or 0.0
    if hub is None:
        return f"spend: agents ${agents:.2f}; the hub's cost is unknown (no transcript, no price for its model)"
    est = "≈" if sp.get("hub_basis") == "estimate" else ""
    return (f"spend: hub {est}${hub:.2f} + agents ${agents:.2f} — the hub is {est}{(sp.get('hub_share') or 0) * 100:.0f} % of the stage"
            + (" (partial: transcript not fully read or a model unpriced)" if sp.get("hub_partial") else ""))


def stage_rows(snap: dict, width: int) -> list:
    """The Stages block: each shown stage with its live agents and last activity; idle and closed ones marked."""
    rows = [R(("Stages (an idle one: no live agent, quiet ≥ " + fmt_age(snap["idle_after_s"]) + " — close it: c)", "bold_u"))]
    info_of = snap["stage_info"]
    for stage in sorted(snap["stages"], key=lambda st: (bool((info_of.get(st) or {}).get("closed")),
                                                        bool((info_of.get(st) or {}).get("idle")), st)):
        info = info_of.get(stage) or {}   # working stages first, then the idle ones (to close), then the closed ones
        closed = info.get("closed")
        ago = f"{fmt_age(info['idle_s'])} ago" if info.get("idle_s") is not None else "—"
        if closed:
            text, st = f"{stage}  CLOSED {str(closed.get('at') or '')[:16].replace('T', ' ')} — {closed.get('why') or ''}", "dim"
        else:
            text = (f"{stage}  {'IDLE  ' if info.get('idle') else ''}live {info.get('live', 0)} · last activity {ago}"
                    + (f" · {info['goal']}" if info.get("goal") else ""))
            st = "warn" if info.get("idle") else "norm"
        rows += wrap_rows(text, width, st, "  ", "    ", 2)
    if snap.get("closed_hidden"):
        rows += wrap_rows(f"{len(snap['closed_hidden'])} closed stage(s) hidden (a shows them): "
                          + ", ".join(snap["closed_hidden"]), width, "dim", "  ", "    ", 2)
    return rows


def lock_home(snap: dict, lk: dict) -> str:
    """" (label)" after a lock's repo while stages come from several homes, so a lock of another home says whose it is."""
    return f" ({lk['home_label']})" if snap.get("multi_home") and lk.get("home_label") else ""


def summary_rows(snap: dict, width: int) -> list:
    rows = stage_rows(snap, width) + [R(("", "norm")), R(("Locks (lock list)", "bold_u"))]
    if not snap["locks"]:
        rows.append(R(("  no locks", "dim")))
    for lk in snap["locks"]:
        st = "norm" if lk["active"] else "dim"
        rows += wrap_rows(f"{lk['kind']} {lk['repo']}{lock_home(snap, lk)} until {lk['until'][:16].replace('T', ' ')}"
                          f"{'' if lk['active'] else ' (expired)'} — {lk['owner_name']}: {lk['why']}", width, st, "  ", "    ", 3)
    rows += [R(("", "norm")), R(("Owner questions (ask summary)", "bold_u"))]
    if not snap["questions"]:
        rows.append(R(("  no data (ask is unavailable or there is no register)", "dim")))
    for stage, q in snap["questions"].items():
        rows += wrap_rows(q["line"], width, "err" if q["overdue"] else "norm", "  ", "    ")
        for ln in q["items"][:8]:
            rows += wrap_rows(ln, width, "dim", "    ", "      ", 2)
    rows += [R(("", "norm")), R(("Roles and hub (roles)", "bold_u"))]
    for stage, rl in snap["roles"].items():
        rows.append(R((f"  {stage}", "bold")))
        for r in rl:
            hub = "* " if r["role"] == "hub" else "  "
            state = WORD.get(r["state"], r["kind"] or "") if r["state"] else (r["kind"] or "")
            rows += wrap_rows(f"{hub}{r['role']} [{r['tag']}] {state}  journal "
                              + (f"{fmt_age(r['journal_age_s'])} ago" if r["journal_age_s"] is not None else "—") + f"  {r['title']}",
                              width, "norm" if r["role"] == "hub" else "dim", "   ", "     ", 2)
        rows += wrap_rows(spend_text(snap["spend"].get(stage) or {}), width, "dim", "   ", "     ", 2)
    lim = snap.get("limits")
    if lim and isinstance(lim["info"], dict):
        rows += [R(("", "norm")), R(("Claude plan limits (latest rate_limit event in the logs)", "bold_u"))]
        for k, lab in (("five_hour", "5 hours"), ("seven_day", "week")):
            w = (lim["info"].get("unifiedWindows") or {}).get(k)
            if isinstance(w, dict):
                reset = w.get("resetsAt")
                rows.append(R((f"  {lab}: {pct(w)}"
                               + (f", resets {dt.datetime.fromtimestamp(reset, hc.TZ):%m-%d %H:%M}" if isinstance(reset, (int, float)) else "")
                               + f"  (from the agents' logs; the freshest log was updated {fmt_age(snap['now'] - lim['seen_at'])} ago)", "norm")))
    for lid, record in sorted(snap.get("codex_limits", {}).items()):
        label = "Codex" if lid == "codex" else f"Codex {one_line(lid)}"
        rows += [R(("", "norm")), R((f"{label} limits (used; latest logged snapshot)", "bold_u"))]
        for w in codex_limits.windows(record["info"]):
            reset_text = ""
            if w["resets_at"] is not None:
                try:
                    reset_text = f", resets {dt.datetime.fromtimestamp(w['resets_at'], hc.TZ):%m-%d %H:%M}"
                except (ValueError, OSError, OverflowError):
                    pass
            rows += wrap_rows(f"{w['label']}: {w['used_percent']:g}% used{reset_text}"
                              + f"  (observed {fmt_age(max(0, snap['now'] - record['seen_at']))} ago)",
                              width, "norm", "  ", "    ")
    return rows


HELP = [
    "agent-top — what the agents are doing", "",
    "List",
    "  ↑ ↓ / PgUp PgDn / Home End   select an agent",
    "  ⏎                            open the agent: log feed, brief, inbox",
    "  j                            stage journal (/ — filter, t — by the agent's tag, , . — day back/forward)",
    "  s                            summary: stages (idle ones marked), locks, owner questions, roles, plan limits",
    "  a                            all agents / only live and recent ones (24 h)",
    "  m                            message the agent (agent send) — with confirmation",
    "  x                            stop the agent (agent stop) — with confirmation",
    "  c                            close a stage whose hub is no longer needed (hub close) — asks which, then y/N",
    "  r                            refresh now;  ?  this help;  q  quit",
    "Agent",
    "  Tab / 1 2 3                  feed · brief · inbox",
    "  ↑ ↓ PgUp PgDn Home           scroll; End — follow the tail again",
    "  [ ]                          previous / next agent;  Esc — back",
    "Marks: ● live  ✓ done  ✗ died/error  yellow ● — live but quiet > 5 min;  ✉N — unread inbox messages",
    "       ▸ command  ◂ result  ✎ thought  ⏳ command still running  * — archive folder of an old run",
    "Cost sums the results of finished runs; a live agent has none yet, so its context size (ctx) is shown.",
]


def help_rows(width: int) -> list:
    rows = []
    for ln in HELP:
        rows += wrap_rows(ln, width, "bold" if ln and not ln.startswith(" ") else "norm", "", "    ")
    return rows


def pace_lines(snap: dict) -> list:
    """The limit-pace advisor line of each engine (bin/limit_pace.py); [] when AGENT_HUB_LIMIT_PACE=off."""
    stage, scope = None, contextlib.nullcontext()
    if len(snap["stages"]) == 1:
        # one stage in view: its own name, and everything the advisor reads for a stage (the mode, the owner's engine
        # decision in the home's settings, the cache) is read in that stage's home, not in the resolved one
        info = snap["stage_info"].get(snap["stages"][0]) or {}
        stage = info.get("name") or snap["stages"][0]
        if info.get("home"):
            scope = hc.in_home(info["home"])
    homes = [h["path"] for h in snap.get("homes") or []] or None   # the plan's limits are the account's: every home's logs
    with scope:
        if limit_pace.mode() == "off":
            return []
        cache = hc.state_dir() / "agent-top" / "limit-pace.json" if os.environ.get("AGENT_TOP_CACHE", "1") != "0" else None
        paces = limit_pace.read_all(now=snap["now"], cache=cache, homes=homes)
        return [(e, paces[e].get("7d"), limit_pace.summary(e, paces, stage)) for e in limit_pace.ENGINES]


def pace_rows(snap: dict, width: int) -> list:
    got = pace_lines(snap)
    if not got:
        return []
    rows = [R(("", "norm")), R(("Limit pace (choose engine/model/effort for this launch)", "bold_u"))]
    for _, p, text in got:
        rows += wrap_rows(text, width, "warn" if p is not None and p.level == "exhaust" else "norm", "  ", "    ")
    return rows


def render_once(snap: dict, coll: Collector, width: int, agent=None, lines: int = 25, tail_journal: int = 8) -> str:
    def txt(rows):
        return [r.fit(width).text().rstrip() for r in rows]

    out = txt([header_row(snap, width, "")])
    out += txt(list_rows(snap, width, None)[0])
    if agent:
        a = find_agent(snap, agent)
        out += ["", "─" * min(width, 60)]
        out += txt(card_rows(a, width))
        feed = Feed(Path(a["log_path"]))
        feed.update()
        fr = txt(feed_rows(feed, width, a["alive"], snap["now"]))
        out += ["", f"feed (last {min(lines, len(fr))} lines):"] + fr[-lines:]
    else:
        out += [""] + txt(summary_rows(snap, width))
        out += txt(pace_rows(snap, width))
        jl = coll.journal(snap["stages"], 0)
        multi = len({s for s, *_ in jl}) > 1
        jr, _ = journal_rows(jl, width, multi, "", None)
        out += ["", f"Journal (last {min(tail_journal, len(jr))} lines):"] + txt(jr[-tail_journal:])
    return "\n".join(out) + "\n"


WIDGET_STATE = {"live": ("live", "success"), "done": ("done", "secondary"), "error": ("error", "danger"),
                "dead": ("died", "danger"), "unknown": ("unknown", "warning"), "stopped": ("stopped", "secondary")}


def render_widget(snap: dict) -> str:
    """An embeddable snapshot with scoped brand accents, host surfaces and no scripts."""
    e = html.escape
    c = snap["counts"]
    locks = [lk for lk in snap["locks"] if lk["active"]]
    q_open = sum(q["open"] for q in snap["questions"].values())
    q_over = sum(q["overdue"] for q in snap["questions"].values())
    lim = (snap.get("limits") or {}).get("info") or {}
    win = lim.get("unifiedWindows") or {}

    def metric(label, value, tone=""):
        col = f"color: var(--text-{tone});" if tone else ""
        return f'<div class="m"><div class="s">{e(label)}</div><div class="v" style="{col}">{e(value)}</div></div>'

    def use_tone(w):
        u = float((w or {}).get("utilization") or 0)
        return "danger" if u >= 0.9 else ("warning" if u >= 0.7 else "")

    bad = c["error"] + c["dead"]
    cards = [metric("running", str(c["live"]), "success" if c["live"] else ""), metric("done", str(c["done"])),
             metric("failed", str(bad), "danger" if bad else ""),
             metric("owner questions", f"{q_open}" + (f" / overdue {q_over}" if q_over else ""), "danger" if q_over else "")]
    if c.get('unknown'):
        cards.append(metric("unknown", str(c['unknown']), "warning"))
    if c.get('stopped'):
        cards.append(metric("stopped", str(c['stopped'])))
    for k, lab in (("five_hour", "limit 5 h"), ("seven_day", "limit week")):
        if isinstance(win.get(k), dict):
            cards.append(metric(lab, pct(win[k]), use_tone(win[k])))
    out = [f'<h2 class="sr-only">Agents of stages {e(", ".join(snap["stages"]) or "—")}: {c["live"]} running, '
           f'{c["done"]} done, {bad} failed.</h2>',
           '<style>.at{--at-navy:#0b1422;--at-panel:#142a40;--at-ice:#77dce8;--at-amber:#eeb34e;'
           'color:var(--text-primary,inherit);font-family:inherit;min-width:0}'
           '.at .at-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;'
           'background:var(--at-navy);color:var(--at-ice);border:1px solid var(--at-panel);'
           'border-left:3px solid var(--at-amber);border-radius:var(--radius,8px);padding:10px 12px;margin:0 0 12px}'
           '.at .at-title{font-size:16px;font-weight:600;margin:0;overflow-wrap:anywhere}'
           '.at .at-brand{color:var(--at-amber);font-size:11px;letter-spacing:.08em}'
           '.at .m{background:var(--surface-1,transparent);border:1px solid var(--border,currentColor);'
           'border-radius:var(--radius,8px);padding:10px 12px;min-width:0}'
           '.at .v{font-size:20px;font-weight:500}.at .s{font-size:12px;color:var(--text-secondary)}'
           '.at .r{display:grid;grid-template-columns:72px minmax(0,1fr);gap:4px 12px;padding:8px 0;border-top:0.5px solid var(--border)}'
           '.at .n{font-size:14px}.at .x{font-size:11px;color:var(--text-muted)}'
           '.at .w{font-size:12px;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}'
           '</style><div class="at">',
           '<div class="at-head"><span class="at-brand">DELAMAIN</span><h3 class="at-title">agent-top</h3></div>',
           '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;margin:0 0 1rem">',
           *cards, '</div>']
    multi = len(snap["stages"]) > 1
    rows = []
    for a in snap["agents"]:
        word, tone = WIDGET_STATE[a["state"]]
        if a["quiet"]:
            word, tone = "quiet", "warning"
        now, _ = what_now(a)
        turns = f"{a['run_turns']} turns (total {a['turns']})" if a["run_turns"] != a["turns"] else \
            f"{a['turns']} turn{'' if a['turns'] == 1 else 's'}"
        meta = [model_label(a), f"{fmt_age(a['age_s'])} ago", turns]
        if a["cost_usd"] is not None:
            meta.append(fmt_cost(a["cost_usd"]))
        if a["unread"]:
            meta.append(f"unread {len(a['unread'])}")
        role = (a["stage"] + "/" if multi else "") + a["role"]
        rows.append(
            f'<div class="r"><div><div class="n" style="font-weight:500">{e(role)}</div>'
            f'<div class="s" style="color:var(--text-{tone})">{e(word)}</div></div>'
            f'<div style="min-width:0"><div class="n">{e(task_text(a))}</div><div class="w">{e(clip(one_line(now), 140))}</div>'
            f'<div class="x">{e(" · ".join(meta))}</div></div></div>')
    out += rows or ['<div class="s">No agents.</div>']
    if locks:
        out.append('<div class="s" style="margin-top:1rem">'
                   + "<br>".join(e(f"lock {lk['kind']} {lk['repo']}{lock_home(snap, lk)} — {lk['owner_name']}, until {(lk['until'] or '')[5:16].replace('T', ' ')}")
                                 for lk in locks) + '</div>')
    # No buttons and no scripts: in the Claude Code desktop tab sendPrompt() from a widget reaches nothing,
    # so the widget names the commands instead.
    out.append(f'<div class="x" style="margin-top:8px">snapshot {e(hhmmss(snap["now"]))} · an agent\'s feed — '
               f'/agent-top &lt;role&gt; or agent-top --once --agent &lt;role&gt;</div></div>')
    return "\n".join(out) + "\n"


def snapshot_json(snap: dict, coll: Collector, agent=None, feed_n: int = 40) -> dict:
    agents = [{k: v for k, v in a.items() if not k.startswith("_")} for a in snap["agents"]]
    out = {"generated_at": snap["generated_at"], "stages": snap["stages"], "closed_hidden": snap["closed_hidden"],
           "homes": snap["homes"], "multi_home": snap["multi_home"], "idle_after_s": snap["idle_after_s"], "stage_info": snap["stage_info"], "counts": snap["counts"], "agents": agents,
           "roles": snap["roles"], "spend": snap["spend"], "locks": snap["locks"], "questions": snap["questions"],
           "questions_ok": snap.get("questions_ok", False), "limits": snap["limits"],
           "codex_limits": snap.get("codex_limits", {}),
           "limit_pace": {e: {"level": p.level if p else "unknown", "used": p.used if p else None,
                              "expected": p.expected if p else None, "resets_at": p.resets_at if p else None,
                              "eta": p.eta if p else None, "confirmed": bool(p and p.confirmed), "text": text}
                          for e, p, text in pace_lines(snap)},
           "journal_tail": [{"stage": s, "time": hh, "tag": t, "text": x} for s, hh, t, x in coll.journal(snap["stages"], 0)[-20:]]}
    if agent:
        a = find_agent(snap, agent)
        feed = Feed(Path(a["log_path"]))
        feed.update()
        out["feed"] = {"agent": a["dir_name"], "stage": a["stage"], "items": [
            {"at": hhmmss(it.ts) or None, "kind": it.kind, "sub": it.sub, "tool": it.tool or None, "text": it.text[:600],
             "detail": it.detail[:400] or None} for it in feed.items[-feed_n:]]}
    return out


# ---------------------------------------------------------------- curses UI

def key_name(ch) -> str:
    if isinstance(ch, str):
        return {"\n": "enter", "\r": "enter", "\x1b": "esc", "\x7f": "bs", "\x08": "bs", "\t": "tab"}.get(ch, ch)
    return {curses.KEY_UP: "up", curses.KEY_DOWN: "down", curses.KEY_PPAGE: "pgup", curses.KEY_NPAGE: "pgdn",
            curses.KEY_HOME: "home", curses.KEY_END: "end", curses.KEY_LEFT: "left", curses.KEY_RIGHT: "right",
            curses.KEY_BACKSPACE: "bs", curses.KEY_ENTER: "enter", curses.KEY_DC: "del", curses.KEY_RESIZE: "resize"}.get(ch, "")


class Scroll:
    def __init__(self):
        self.pos, self.follow, self.n, self.h = 0, True, 0, 1

    def window(self, n: int, h: int) -> int:
        self.n, self.h = n, max(1, h)
        maxpos = max(0, n - self.h)
        if self.follow:
            self.pos = maxpos
        self.pos = min(max(0, self.pos), maxpos)
        return self.pos

    def key(self, k: str) -> None:
        maxpos = max(0, self.n - self.h)
        step = {"up": -1, "down": 1, "pgup": -(self.h - 1), "pgdn": self.h - 1}.get(k)
        if step is not None:
            self.follow = False
            self.pos = min(max(0, self.pos + step), maxpos)
        elif k == "home":
            self.follow, self.pos = False, 0
        elif k == "end":
            self.follow = True
        if self.pos >= maxpos and k in ("down", "pgdn"):
            self.follow = True


class App:
    def __init__(self, cfg, coll: Collector):
        self.cfg, self.coll = cfg, coll
        self.view, self.tab, self.sel_key, self.prev_view = "list", "feed", None, "list"
        self.scroll = {n: Scroll() for n in ("feed", "brief", "inbox", "journal", "summary", "help")}
        self.snap, self.dirty = None, True
        self.toast, self.toast_until, self.toast_style = "", 0.0, "norm"
        self.mode, self.inp, self.confirm = None, None, None   # mode: input | confirm
        self.flt, self.tag_flt, self.jday = "", None, 0
        self.busy = ""
        self.feed = None

    # -- data
    def refresh(self):
        self.snap = self.coll.snapshot()
        agents = self.snap["agents"]
        if agents and self.sel_key not in {agent_key(a) for a in agents}:
            self.sel_key = agent_key(agents[0])
        self.dirty = True

    def selected(self):
        return next((a for a in self.snap["agents"] if agent_key(a) == self.sel_key), None) if self.snap else None

    def say(self, text: str, style: str = "norm", secs: float = 8.0):
        self.toast, self.toast_style, self.toast_until, self.dirty = text, style, time.monotonic() + secs, True

    # -- screen
    def build(self, width: int, height: int) -> tuple:
        snap = self.snap
        label = {"list": "", "agent": "agent", "journal": "journal", "summary": "summary", "help": "help"}[self.view]
        rows = [header_row(snap, width, label + " " if label else "")]
        body_h = height - 2
        sel_row = -1
        if self.view == "list":
            body, sel_row = list_rows(snap, width, self.sel_key, body_h)
        elif self.view == "agent":
            body = self._agent_body(width, body_h)
        elif self.view == "journal":
            body = self._journal_body(width, body_h)
        elif self.view == "summary":
            body = self._windowed("summary", summary_rows(snap, width), body_h)
        else:
            body = self._windowed("help", help_rows(width), body_h)
        rows += [r.fit(width) for r in body[:body_h]]
        while len(rows) < height - 1:
            rows.append(R(("", "norm")))
        rows.append(self._bottom(width))
        return rows, sel_row

    def _windowed(self, name: str, all_rows: list, h: int) -> list:
        pos = self.scroll[name].window(len(all_rows), h)
        return all_rows[pos:pos + h]

    def _agent_body(self, width: int, h: int) -> list:
        a = self.selected()
        if not a:
            return [R(("(no agent)", "dim"))]
        card = card_rows(a, width)
        tabs = []
        for key, name in (("feed", "1 feed"), ("brief", "2 brief"), ("inbox", "3 inbox")):
            tabs.append((f" {name} ", "sel" if self.tab == key else "dim"))
        rows = card[:max(3, h // 2)] + [Row(tabs)]
        room = max(1, h - len(rows))
        if self.tab == "feed":
            if self.feed is None or str(self.feed.path) != a["log_path"]:
                self.feed = Feed(Path(a["log_path"]))
            self.feed.update()
            content = feed_rows(self.feed, width, a["alive"], self.snap["now"])
        elif self.tab == "brief":
            content = brief_rows(a["brief_path"], width)
        else:
            content = brief_rows(a["inbox_path"], width, [u["msg"] for u in a["unread"]])
        return rows + self._windowed(self.tab, content, room)

    def _journal_body(self, width: int, h: int) -> list:
        stages = self.snap["stages"]
        lines = self.coll.journal(stages, self.jday)
        multi = len({s for s, *_ in lines}) > 1
        jr, shown = journal_rows(lines, width, multi, self.flt, self.tag_flt)
        day = "today" if self.jday == 0 else f"{self.jday} d ago"
        flt = (f" · tag {self.tag_flt}" if self.tag_flt else "") + (f' · "{self.flt}"' if self.flt else "")
        head = R((clip(f" journal {day}: {shown} of {len(lines)} lines{flt}", width), "dim_u"))
        return [head] + self._windowed("journal", jr or [R(("  (empty)", "dim"))], h - 1)

    def _bottom(self, width: int) -> Row:
        if self.mode == "input":
            cur = self.inp["cur"]
            buf = "".join(self.inp["buf"][:cur]) + "│" + "".join(self.inp["buf"][cur:])
            prompt = self.inp["prompt"]
            room = max(4, width - dispw(prompt) - 1)
            shown = buf if dispw(buf) <= room else "…" + buf[-(room - 1):]
            return Row([(prompt, "key"), (pad(shown, room), "norm")], fill="norm")
        if self.mode == "confirm":
            return Row([(pad(self.confirm["prompt"], width), "confirm")], fill="confirm")
        if self.toast and time.monotonic() < self.toast_until:
            return Row([(pad(" " + self.toast, width), self.toast_style)], fill=self.toast_style)
        if self.busy:
            return Row([(pad(" ⏳ " + self.busy, width), "warn")], fill="warn")
        keys = {
            "list": [" ↑↓ select  ⏎ agent  j journal  s summary  a all  m message  x stop  c close stage  ? help  q quit",
                     " ↑↓ ⏎ agent  j journal  s summary  a all  m x c  ? q", " ⏎ j s a m x c ? q"],
            "agent": [" Esc back  Tab tab  ↑↓ scroll  End tail  [ ] agent  m message  x stop  j journal  q quit",
                      " Esc  Tab  ↑↓  End  [ ]  m x j  q", " Esc Tab ↑↓ q"],
            "journal": [" Esc back  ↑↓ scroll  / filter  t by tag  c reset  , . day  q quit", " Esc  ↑↓  / t c  , .  q", " Esc / t q"],
            "summary": [" Esc back  ↑↓ scroll  c close stage  q quit", " Esc  ↑↓  c  q", " Esc q"],
            "help": [" any key — back  q quit", " any — back", " ? q"],
        }[self.view]
        text = next((k for k in keys if dispw(k) <= width), keys[-1])
        if self.cfg.read_only:
            text = (text.replace("m message  x stop  c close stage  ", "").replace("  c close stage", "")
                    .replace(" m x c ", " ").replace("  c  ", "  ").replace(" m x c", ""))
        return Row([(pad(text, width), "key")], fill="key")

    # -- keys
    def on_key(self, ch) -> bool:
        """Returns True to quit."""
        k = key_name(ch)
        if k == "resize":
            self.dirty = True
            return False
        self.dirty = True
        if self.mode == "input":
            return self._input_key(ch, k)
        if self.mode == "confirm":
            done, self.mode = self.confirm, None
            if k in ("y", "Y"):
                self._run_action(done)
            else:
                self.say("cancelled", "dim", 3)
            return False
        if k == "q":
            return True
        if self.view == "help":
            self.view = self.prev_view
            return False
        if k == "?":
            self.prev_view, self.view = self.view, "help"
            return False
        if k == "r":
            self.refresh()
            return False
        if k in ("m", "x"):
            self._start_action(k)
            return False
        if k == "c" and self.view != "journal":   # the journal's own `c` resets its filter
            self._start_close()
            return False
        if self.view == "list":
            self._list_key(k)
        elif self.view == "agent":
            self._agent_key(k)
        elif self.view == "journal":
            self._journal_key(k)
        else:
            if k in ("esc", "bs", "left"):
                self.view = "list"
            else:
                self.scroll[self.view].key(k)
        return False

    def _move(self, delta=None, to=None):
        agents = self.snap["agents"]
        if not agents:
            return
        i = next((i for i, a in enumerate(agents) if agent_key(a) == self.sel_key), 0)
        i = to if to is not None else min(max(0, i + delta), len(agents) - 1)
        self.sel_key = agent_key(agents[i])

    def _list_key(self, k: str):
        if k == "up":
            self._move(-1)
        elif k == "down":
            self._move(1)
        elif k == "pgup":
            self._move(-10)
        elif k == "pgdn":
            self._move(10)
        elif k == "home":
            self._move(to=0)
        elif k == "end":
            self._move(to=len(self.snap["agents"]) - 1)
        elif k == "enter" and self.selected():
            self.view, self.tab = "agent", "feed"
            self._reset_agent_scroll()
        elif k == "j":
            self.view = "journal"
        elif k == "s":
            self.view = "summary"
        elif k == "a":
            self.coll.show_all = not self.coll.show_all
            self.say("showing all agents, including old and archived ones" if self.coll.show_all else "only live and recent ones (24 h)", "dim", 4)
            self.refresh()

    def _reset_agent_scroll(self):
        for n in ("feed", "brief", "inbox"):
            self.scroll[n] = Scroll()

    def _agent_key(self, k: str):
        if k in ("esc", "bs", "left"):
            self.view = "list"
        elif k == "tab":
            order = ["feed", "brief", "inbox"]
            self.tab = order[(order.index(self.tab) + 1) % 3]
        elif k in ("1", "2", "3"):
            self.tab = {"1": "feed", "2": "brief", "3": "inbox"}[k]
        elif k in ("[", "]"):
            self._move(-1 if k == "[" else 1)
            self._reset_agent_scroll()
            self.feed = None
        elif k == "j":
            a = self.selected()
            self.tag_flt = a["tag"] if a else None
            self.view = "journal"
        else:
            self.scroll[self.tab].key(k)

    def _journal_key(self, k: str):
        if k in ("esc", "bs", "left"):
            self.view = "agent" if self.prev_view == "agent" else "list"
        elif k == "/":
            self.mode, self.inp = "input", {"prompt": " filter: ", "buf": list(self.flt), "cur": len(self.flt), "on_enter": self._set_filter}
        elif k == "t":
            a = self.selected()
            self.tag_flt = None if self.tag_flt else (a["tag"] if a else None)
        elif k == "c":
            self.flt, self.tag_flt = "", None
        elif k == ",":
            self.jday += 1
        elif k == ".":
            self.jday = max(0, self.jday - 1)
        else:
            self.scroll["journal"].key(k)

    def _set_filter(self, text: str):
        self.flt = text.strip()

    # -- input line
    def _input_key(self, ch, k: str) -> bool:
        st = self.inp
        buf, cur = st["buf"], st["cur"]
        if k == "esc":
            self.mode = None
            self.say("cancelled", "dim", 3)
        elif k == "enter":
            self.mode = None
            text = "".join(buf)
            st["on_enter"](text)
        elif k == "bs":
            if cur:
                del buf[cur - 1]
                st["cur"] = cur - 1
        elif k == "del":
            if cur < len(buf):
                del buf[cur]
        elif k == "left":
            st["cur"] = max(0, cur - 1)
        elif k == "right":
            st["cur"] = min(len(buf), cur + 1)
        elif k == "home":
            st["cur"] = 0
        elif k == "end":
            st["cur"] = len(buf)
        elif isinstance(ch, str) and ch.isprintable():
            buf.insert(cur, ch)
            st["cur"] = cur + 1
        return False

    # -- actions (through `agent send` / `agent stop` / `hub close` only)
    def _start_action(self, k: str):
        a = self.selected()
        if self.cfg.read_only:
            self.say("--read-only mode: actions are disabled", "warn")
            return
        if not a:
            return
        if a["archived"]:
            self.say("archive folder of an old run — no actions", "warn")
            return
        if a.get("kind") == "subagent":
            self.say(f"sub-agent of {a['parent']}: only its parent session can message or stop it", "warn")
            return
        if a.get("kind") == "session":
            self.say("native Codex session: continue or stop it in Codex", "warn")
            return
        if k == "m":
            self.mode = "input"
            self.inp = {"prompt": f" message to {a['role']}: ", "buf": [], "cur": 0,
                        "on_enter": lambda text, a=a: self._confirm_send(a, text)}
        else:
            what = ("STOP: SIGTERM to the process group, role released, work interrupted" if a["alive"]
                    else "RELEASE: the process is already gone, release the role")
            self._ask_confirm(f" {what} — {a['role']} ({a['stage']})? [y/N] ", {"kind": "stop", "a": a})

    def _start_close(self):
        """`c`: which stage to close — the selected agent's, else the first idle one — then a y/N confirmation."""
        if self.cfg.read_only:
            self.say("--read-only mode: actions are disabled", "warn")
            return
        a = self.selected() if self.view != "summary" else None
        info = self.snap.get("stage_info") or {}
        idle = [st for st in self.snap["stages"] if (info.get(st) or {}).get("idle")]
        guess = a["stage"] if a else (idle[0] if idle else "")
        self.mode = "input"
        self.inp = {"prompt": " close stage (Enter, Esc cancels): ", "buf": list(guess), "cur": len(guess),
                    "on_enter": self._confirm_close}

    def _confirm_close(self, text: str):
        stage = text.strip()
        if not stage:
            self.say("no stage — cancelled", "dim", 3)
            return
        info = (self.snap.get("stage_info") or {}).get(stage)
        if info is None:
            self.say(f"no stage {stage!r} in this view", "warn")
            return
        if info.get("closed"):
            self.say(f"stage {stage} is already closed", "warn")
            return
        live = f" ({info['live']} live agent(s): it refuses)" if info.get("live") else ""
        # what the confirmation holds is the stage's home and own name, taken now: its id on screen may change by the time
        # the y is pressed (another home gaining a stage of the same name), and the answer must still act on this one
        self._ask_confirm(f" CLOSE stage {stage}? [y/N]{live} — hub close: locks released, roles retired, a background hub stopped ",
                          {"kind": "close", "stage": stage, "name": info.get("name") or stage, "home": info.get("home")})

    def _confirm_send(self, a: dict, text: str):
        text = one_line(text)
        if not text:
            self.say("empty message — cancelled", "dim", 3)
            return
        eff = ("live: goes to its inbox, read after a step" if a["alive"]
               else "no process: the session will be RESUMED, this spends tokens")
        self._ask_confirm(f' send to {a["role"]} ({eff}): "{clip(text, 60)}"? [y/N] ', {"kind": "send", "a": a, "text": text})

    def _ask_confirm(self, prompt: str, action: dict):
        self.mode, self.confirm = "confirm", dict(action, prompt=prompt)

    def _run_action(self, act: dict):
        if act["kind"] == "close":
            name, env = self._stage_target(act["name"], act["home"])
            argv = [os.environ.get("AGENT_TOP_HUB_BIN") or str(BIN / "hub"), "close", "--stage", name,
                    "--why", "closed from agent-top"]
            self.busy = f"hub close {act['stage']}…"
            threading.Thread(target=self._action_thread, args=(argv, env, act["stage"], "close"), daemon=True).start()
            return
        a = act["a"]
        agent_bin = os.environ.get("AGENT_TOP_AGENT_BIN") or str(BIN / "agent")
        name, env = self._stage_target(a.get("stage_name") or a["stage"], a.get("home"))
        if act["kind"] == "send":
            argv = [agent_bin, "send", a["role"], "--stage", name, "--", act["text"]]
            self.busy = f"agent send {a['role']}…"
        else:
            argv = [agent_bin, "stop", a["role"], "--stage", name]
            self.busy = f"agent stop {a['role']}…"
        with hc.in_home(a["home"]) if a.get("home") else contextlib.nullcontext():
            owned = hc.caller_tag(name)
        if not owned:
            env["HUB_TAG"] = "owner"              # journal lines of a message typed here are the owner's
        threading.Thread(target=self._action_thread, args=(argv, env, a["role"], act["kind"]), daemon=True).start()

    def _stage_target(self, name: str, home) -> tuple:
        """(the stage's own name, the environment to run a hub tool for it in): the tools address the stage in the home
        they resolve, so a stage of another home gets that home in $AGENT_HUB_HOME. Both come from what the action
        captured (the agent's or the stage's record), never from a lookup by the id shown, which can change."""
        env = dict(os.environ)
        if home and hc.real_path(home) != hc.real_path(hc.root()):
            env["AGENT_HUB_HOME"] = str(home)
        return name, env

    def _action_thread(self, argv: list, env: dict, role: str, kind: str):
        try:
            r = subprocess.run(argv, capture_output=True, text=True, env=env, timeout=240)
            out = (r.stdout.strip().splitlines() or [""])[0] if r.returncode == 0 else (r.stderr.strip().splitlines() or [f"exit code {r.returncode}"])[-1]
            self.busy = ""
            warn = r.returncode == 0 and "ATTENTION:" in out   # closed, but its hub session still runs: keep it in sight
            self.say(("✓ " if r.returncode == 0 else "✗ ") + f"{kind} {role}: {one_line(out)}",
                     "warn" if warn else "ok" if r.returncode == 0 else "err_bar", 60 if warn else 12)
        except (OSError, subprocess.TimeoutExpired) as e:
            self.busy = ""
            self.say(f"✗ {kind} {role}: {e}", "err_bar", 12)


def make_styles() -> dict:
    A = curses
    names = ("norm", "dim", "dim_u", "bold", "bold_u", "head", "head_b", "head_live", "head_err", "live", "done", "err", "warn",
             "sel", "key", "confirm", "ok", "err_bar", "tool", "tool_p", "tag0", "tag1", "tag2", "tag3", "tag4", "tag5")
    st = {n: A.A_NORMAL for n in names}
    st.update(dim=A.A_DIM, dim_u=A.A_DIM | A.A_UNDERLINE, bold=A.A_BOLD, bold_u=A.A_BOLD | A.A_UNDERLINE,
              head=A.A_REVERSE, head_b=A.A_REVERSE | A.A_BOLD, head_live=A.A_REVERSE | A.A_BOLD, head_err=A.A_REVERSE | A.A_BOLD,
              sel=A.A_REVERSE | A.A_BOLD, key=A.A_REVERSE, confirm=A.A_REVERSE | A.A_BOLD, ok=A.A_REVERSE | A.A_BOLD,
              err_bar=A.A_REVERSE | A.A_BOLD, warn=A.A_BOLD, err=A.A_BOLD, live=A.A_BOLD, tool_p=A.A_BOLD)
    if A.has_colors() and "NO_COLOR" not in os.environ:
        try:
            A.start_color()
        except curses.error:
            return st
        try:
            A.use_default_colors()
            bg = -1
        except curses.error:
            bg = A.COLOR_BLACK
        # Nearest indexed colors of the brand palette; never redefine the terminal's color slots.
        rich = A.COLORS >= 256
        ice, amber, navy, panel = (116, 215, 233, 235) if rich else (A.COLOR_CYAN, A.COLOR_YELLOW, bg, bg)
        spec = {"live": (A.COLOR_GREEN, bg, A.A_BOLD), "done": (ice, bg, 0), "err": (A.COLOR_RED, bg, A.A_BOLD),
                "warn": (amber, bg, A.A_BOLD), "tool": (ice, bg, 0), "tool_p": (A.COLOR_GREEN, bg, A.A_BOLD),
                "head": (ice, navy, 0), "head_b": (amber, navy, A.A_BOLD),
                "head_live": (A.COLOR_GREEN, navy, A.A_BOLD), "head_err": (A.COLOR_RED, navy, A.A_BOLD),
                "sel": (ice, panel, A.A_BOLD) if rich else (A.COLOR_BLACK, ice, A.A_BOLD),
                "key": (ice, panel, A.A_BOLD) if rich else (A.COLOR_BLACK, ice, 0),
                "confirm": (A.COLOR_BLACK, amber, A.A_BOLD), "ok": (A.COLOR_BLACK, A.COLOR_GREEN, 0),
                "err_bar": (A.COLOR_WHITE, A.COLOR_RED, A.A_BOLD)}
        spec.update({"tag%d" % j: (col, bg, 0) for j, col in
                     enumerate((A.COLOR_MAGENTA, ice, amber, A.COLOR_GREEN, A.COLOR_BLUE, A.COLOR_RED))})
        for i, (name, (fg, b, extra)) in enumerate(spec.items(), 1):
            # Tiny palettes/pair tables and terminals rejecting a pair keep the monochrome attributes.
            if i >= A.COLOR_PAIRS or fg >= A.COLORS or b >= A.COLORS:
                continue
            try:
                A.init_pair(i, fg, b)
                st[name] = A.color_pair(i) | extra
            except curses.error:
                pass
    return st


def draw(scr, rows: list, styles: dict, width: int, height: int, sel_row: int):
    scr.erase()
    for y, row in enumerate(rows[:height]):
        x = 0
        fill = styles.get(row.fill) if row.fill else None
        if fill is not None:
            try:
                scr.addstr(y, 0, " " * (width - 1), fill)
            except curses.error:
                pass
        for text, style in row.segs:
            room = width - 1 - x
            if room <= 0:
                break
            t = clip(text, room, ellipsis=False)
            try:
                scr.addstr(y, x, t, styles.get(style, curses.A_NORMAL))
            except curses.error:
                pass
            x += dispw(t)
    scr.refresh()


def run_ui(cfg) -> int:
    os.environ.setdefault("ESCDELAY", "25")
    locale.setlocale(locale.LC_ALL, "")
    coll = Collector(cfg.stage, cfg.all, cfg.stale)
    app = App(cfg, coll)

    def loop(scr):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        styles = make_styles()
        scr.timeout(150)
        scr.keypad(True)
        last = 0.0
        while True:
            if app.snap is None or time.monotonic() - last >= cfg.interval:
                try:
                    app.refresh()
                except Exception as e:  # noqa: BLE001 — a console that stays up beats one that dies on an odd file
                    if app.snap is None:
                        raise
                    app.say(f"✗ refresh failed: {e!r}", "err_bar", 5)
                last = time.monotonic()
            if app.toast and time.monotonic() >= app.toast_until:
                app.toast, app.dirty = "", True
            if app.busy:
                app.dirty = True
            if app.dirty:
                h, w = scr.getmaxyx()
                if h >= 4 and w >= 20:
                    try:
                        rows, sel = app.build(w - 1, h)      # the last column stays free: curses cannot write the corner cell
                    except Exception as e:  # noqa: BLE001
                        app.say(f"✗ screen: {e!r}", "err_bar", 5)
                        rows, sel = [R((clip(f" render error: {e!r}", w - 1), "err"))], -1
                    draw(scr, rows, styles, w, h, sel)
                else:
                    scr.erase()
                    scr.addstr(0, 0, "window too narrow"[: max(0, w - 1)])
                    scr.refresh()
                app.dirty = False
            try:
                ch = scr.get_wch()
            except curses.error:
                continue
            if app.on_key(ch):
                return 0

    return curses.wrapper(loop)


# ---------------------------------------------------------------- main

def main(argv: list) -> int:
    p = argparse.ArgumentParser(prog="agent-top", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--stage", action="append", help="stage (repeatable; a bare name matches it in every home, `name · label` in one); default: every stage of every known home that has agents or roles")
    p.add_argument("--all", action="store_true", help="also finished agents older than 24 h and the archive folders of old runs")
    p.add_argument("--once", action="store_true", help="print a text picture and exit")
    p.add_argument("--json", action="store_true", help="the same data as JSON, for scripts")
    p.add_argument("--widget", action="store_true", help="HTML fragment of the snapshot, for scripts")
    p.add_argument("--agent", help="with --once/--json: card and feed of this agent (role or folder name)")
    p.add_argument("--lines", type=int, default=25, help="with --once --agent: feed lines")
    p.add_argument("--feed", type=int, default=40, help="with --json --agent: feed events")
    p.add_argument("--width", type=int, help="width of the --once picture (default: the terminal, else 100)")
    p.add_argument("--interval", type=float, default=1.5, help="refresh period, seconds (1–2)")
    p.add_argument("--stale", type=int, default=STALE_S, help="a live agent with no log events for longer than this many seconds is marked \"quiet\"")
    p.add_argument("--read-only", action="store_true", help="disable m (message) and x (stop)")
    a = p.parse_args(argv)
    if a.interval < 0.3:
        raise hc.UsageError("--interval must be at least 0.3 s")
    if a.once or a.json or a.widget:
        coll = Collector(a.stage, a.all, a.stale)
        snap = coll.snapshot(wait_ext=True)
        if a.agent and not find_agent(snap, a.agent):
            raise hc.Failure(f"no agent {a.agent!r} (--all includes old ones; stages: {', '.join(snap['stages']) or '—'})")
        if a.widget:
            sys.stdout.write(render_widget(snap))
        elif a.json:
            print(json.dumps(snapshot_json(snap, coll, a.agent, a.feed), ensure_ascii=False, indent=1, default=str))
        else:
            width = a.width or shutil.get_terminal_size((100, 24)).columns
            sys.stdout.write(render_once(snap, coll, max(40, width), a.agent, a.lines))
        return 0
    if not sys.stdout.isatty() or not sys.stdin.isatty():
        raise hc.UsageError("interactive mode needs a terminal; for scripts use --once or --json")
    return run_ui(a)


if __name__ == "__main__":
    raise SystemExit(hc.run_main(main, sys.argv[1:]))
