#!/usr/bin/env python3
"""Wait for new lines in the stage journal and/or log files; print them as one block and exit.

The only waiter a hub needs. Run it as ONE command with Bash `run_in_background: true`;
the harness wakes you when it exits. In Claude Code a hub runs it with --stream as the command of ONE Monitor instead:
each batch is a Monitor event whose text carries the lines, so a wake costs one model call and needs no re-arm.

  jwait --journal [--stage stage-a] [--file PATH ...] [--hub-events] [--match REGEX ...] [--tag T ...]
        [--exclude-tag T ...] [--settle 20] [--until HH:MM[:SS] | --for 6h] [--note "…"] [--since HH:MM|ISO]
        [--stream]
  jwait --until 20:23 --note "check the nightly import"   # pure alarm, no source
  jwait --until 20:23:30 --note "…"                        # to the second; so does --until 2026-10-04T20:23:30

Sources: --journal (today's journal of the stage, follows midnight rollover) and/or --file PATH
(any log; may not exist yet). Several allowed.
Filters (a line is delivered when ANY positive filter matches; no positive filter = every new line):
  --hub-events    standard hub terminal/question words plus AGENT_HUB_JWAIT_MATCH
  --match REGEX   Python regex searched in the line (repeatable; adds to --hub-events)
  --tag T         line written with tag T or a sub-tag T/…, or addressed "@T" or "@<this stage>-T"
                  (the stage-qualified signature of another stage's hub, jlog's `core-c-hub-30`) (repeatable)
Held lines (deliver without waking): a line that passes the filters only by being addressed to the hub (`--tag hub`)
                  and is signed by another stage's hub (`[dolya-hub-35] @hub …`, as `tell` writes) or by the limit
                  pacer (`[pace] @hub LIMIT …`) does not wake: it is printed with the next batch that does, or at the
                  deadline, under "HELD". It wakes like any line when it also matches a status word (--hub-events),
                  FAILED, TIMEOUT, CONFLICT or URGENT (`tell --urgent`), or a --match pattern.
Exclusions (always win):
  --exclude-tag T drops lines written with tag T and its sub-tags T/… (repeatable). The caller's
                  own tag ($HUB_TAG or the registry) is excluded by default, in both forms: T and
                  <own stage>-T, as jlog signs in another stage's journal; --include-own keeps it.
                  A sub-agent's start and end lines (`[<tag>/<agent id>] SUB start …`, `… SUB end …`, written by
                  the plugin's SubagentStart/SubagentStop hooks) are never delivered: they are for the record.
State: what each caller has already seen per source lives in <root>/.jwait-state/<caller>.json,
keyed by a hash of the line and its occurrence number, so a rewritten or replayed file does not
re-deliver old lines, and lines that arrived while you were busy are delivered on the next run.
The first run of a caller on a stage journal only marks existing lines as seen and says so.
--since HH:MM or an ISO time delivers the journal lines stamped from that time on the initial read,
whether or not the caller has seen them (`hub takeover` prints it). A --file source delivers every
unseen matching line, even the first time (a script may have asked its question before jwait
started); a last line without a newline is delivered after it stays unchanged for max(--settle, 1) s.
Batching: after the first match keeps collecting for --settle seconds (default 20), then prints.
Deadline: --until HH:MM, HH:MM:SS or ISO, with or without seconds (hub time zone; a past clock time means
tomorrow) or --for 6h; default --for 50m ($AGENT_HUB_JWAIT_FOR; the prompt cache lives one hour, so a hub that
sleeps longer pays for re-writing its whole context at every wake, and Claude Code 2.1.299+ compacts a 200K+ conversation idle for
~54 minutes; wait again after the alarm). On the
deadline prints "ALARM <note>" and exits 3.
With --journal it marks itself in <root>/.jwait-state/<stage>/<caller>.armed.json while it waits (the watchdog reads it: a hub with a live
waiter is not woken).
With --journal it also looks, every 10 s, for a headless agent of the stage whose process is gone without a result
(killed, not stopped by `agent stop`) and journals `EXIT <role>: killed (no result)` once, so the line wakes you.
--stream: after each batch, print it and keep waiting until the deadline (default --for 29m: a Monitor lives at most
30 minutes); a batch is one Monitor event, the deadline ALARM ends the stream.
NEXT WAIT (Claude host, --journal): when a run ends, a last line says how to wait next, so the hub does not reason
about it: a Monitor stream while something of the stage runs (a live headless agent, an `await` supervisor), else ONE
long background wait (idle: up to 8h, inside the Bash timeout cap BASH_MAX_TIMEOUT_MS, 2h unset). An idle hub then costs
no model call until a line comes; the Monitor's 30-minute cap would wake it twice an hour for nothing.
A held line wakes after HELD_MAX (30 min) at the latest, so a long idle wait does not sit on another hub's message.
Exit: 0 lines delivered, 3 deadline, 1 failure, 2 usage.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import shlex
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hubcore as hc  # noqa: E402

POLL_S = 1.0
DEAD_POLL_S = 10.0  # how often --journal looks for a headless agent whose process is gone without a result
DEFAULT_FOR = hc.DEFAULT_JWAIT_FOR  # the built-in; main() reads hc.jwait_for() ($AGENT_HUB_JWAIT_FOR)
MAX_OUT_LINES = 200
MAX_LINE_CHARS = 1200
STREAM_FOR = "29m"  # a Claude Code Monitor is killed after 30 minutes; the ALARM comes first
MONITOR_TIMEOUT_MS = 1_800_000
IDLE_FOR_S = 8 * 3600  # an idle hub's background wait; trimmed to the Bash timeout cap
BASH_CAP_DEFAULT_MS = 2 * 3600 * 1000  # Claude Code's cap on a Bash call's timeout unless BASH_MAX_TIMEOUT_MS
HELD_MAX_S = 30 * 60  # a held line waits at most this long for a waking batch
# Words that make a held line (another stage's hub, the pacer) wake after all, besides the status words.
HELD_WAKE_RE = re.compile(r"\b(FAILED|TIMEOUT|CONFLICT|URGENT)\b")
HELD_TAGS = ("pace",)  # limit_pace's tag: an `@hub LIMIT …` crossing is context for the next launch, not a decision now


def line_key(line: str, occurrence: int) -> str:
    return hashlib.sha1(f"{occurrence}\x00{line}".encode("utf-8")).hexdigest()[:16]


class Source:
    """A text file re-read whole whenever its (inode, size, mtime) changes.

    Keys are computed over the whole file every time, so an append, an in-place edit (Edit tool,
    `sed -i`), a truncation or a replacement all yield exactly the lines whose content is new.
    A last line without a newline (a script blocked on `read -p "AWAITING ANSWER …"`) is delivered once
    it has not changed for `partial_after` seconds; its key is the one the completed line will get,
    so the newline arriving later does not deliver it twice.
    """

    def __init__(self, sid: str, path: Path, label: str, is_journal: bool, partial_after: float = 20.0):
        self.sid, self.path, self.label, self.is_journal = sid, path, label, is_journal
        self.partial_after = partial_after
        self.sig = None
        self.present: set = set()  # keys of lines currently in the file (and a delivered partial)
        self.polls = 0
        self.partial = None  # (key, text, first seen monotonic) of an undelivered last line

    def poll(self) -> list:
        """Lines not present at the previous read, as (key, text)."""
        self.polls += 1
        try:
            st = os.stat(self.path)
        except FileNotFoundError:
            return []
        sig = (st.st_ino, st.st_size, st.st_mtime_ns)
        if sig == self.sig:
            return self._stable_partial()
        self.sig = sig
        with open(self.path, "rb") as fh:
            data = fh.read()
        *complete, tail = data.split(b"\n")
        counts: dict = {}
        keys, out = set(), []
        for raw in complete:
            text = raw.decode("utf-8", errors="replace").rstrip("\r")
            if not text.strip():
                continue
            n = counts.get(text, 0)
            counts[text] = n + 1
            key = line_key(text, n)
            keys.add(key)
            if key not in self.present:
                out.append((key, text))
        text = tail.decode("utf-8", errors="replace").rstrip("\r")
        if text.strip():
            key = line_key(text, counts.get(text, 0))
            if key in self.present:
                keys.add(key)  # already delivered as a partial
                self.partial = None
            elif not (self.partial and self.partial[0] == key):
                self.partial = (key, text, time.monotonic())
        else:
            self.partial = None
        self.present = keys
        return out + self._stable_partial()

    def _stable_partial(self) -> list:
        if self.partial and time.monotonic() - self.partial[2] >= self.partial_after:
            key, text, _ = self.partial
            self.partial = None
            self.present.add(key)
            return [(key, text)]
        return []


class JournalSources:
    """Journal of each day from the start day to today (midnight rollover)."""

    def __init__(self, stage: str, start_day: dt.date):
        self.stage, self.start_day = stage, start_day
        self.by_day: dict = {}

    def sources(self) -> list:
        today = hc.now().date()
        day = self.start_day
        while day <= today:
            if day not in self.by_day:
                path = hc.journal_path(self.stage, day)
                self.by_day[day] = Source(f"journal:{self.stage}:{day.isoformat()}", path,
                                          f"journal {day:%d.%m}", True)
            day += dt.timedelta(days=1)
        return list(self.by_day.values())


class DeadAgentWatch:
    """Observer of the stage's headless agents for `--journal`: an agent killed without a result (kill -9 of its whole
    process group, so the exit-note wrapper died too) is journaled once as `EXIT <role>: killed (no result)`, which the
    hub's default match wakes on. The check is `agent`'s own (observe_dead), loaded on the first tick; whatever fails
    in it is not jwait's failure."""

    def __init__(self, stage: str):
        self.stage, self.memo, self.next_at, self.mod = stage, {}, 0.0, None

    def tick(self) -> None:
        if time.monotonic() < self.next_at:
            return
        self.next_at = time.monotonic() + DEAD_POLL_S
        try:
            if self.mod is None:
                path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent")
                loader = importlib.machinery.SourceFileLoader("agent_cli", path)
                self.mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("agent_cli", loader))
                loader.exec_module(self.mod)
            self.mod.observe_dead(self.stage, self.memo)
        except Exception:  # noqa: BLE001
            pass


def safe_name(name: str) -> str:
    return re.sub(r"[^\w.-]+", "_", name, flags=re.UNICODE).strip("_") or "anon"


def state_path(caller: str) -> Path:
    return hc.root() / ".jwait-state" / f"{safe_name(caller)}.json"


def load_state(caller: str) -> dict:
    try:
        return json.loads(state_path(caller).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except ValueError:
        return {}  # a broken state file only costs one baseline run


def save_state(caller: str, updates: dict) -> None:
    """Merge seen keys per source under a lock; keep only keys still present in each source."""
    path = state_path(caller)
    with hc.Flock(path.with_suffix(".lock")):
        state = load_state(caller)
        for sid, (seen, present) in updates.items():
            old = set(state.get(sid, {}).get("seen", []))
            merged = (old | seen) & present if present else (old | seen)
            state[sid] = {"seen": sorted(merged), "at": hc.now().isoformat(timespec="seconds")}
        cutoff = (hc.now() - dt.timedelta(days=3)).isoformat()
        state = {k: v for k, v in state.items() if v.get("at", "") >= cutoff}
        hc.atomic_write(path, json.dumps(state, ensure_ascii=False) + "\n")


class Filter:
    def __init__(self, args, own_tag, stage=None):
        self.stage = stage
        try:
            patterns = list(args.match)
            if getattr(args, "hub_events", False):
                patterns.append(hc.status_pattern())
            self.patterns = [re.compile(p) for p in patterns]
        except re.error as e:
            raise hc.UsageError(f"bad --match: {e}") from None
        self.tags = [t.strip() for t in args.tag]
        self.exclude = [t.strip() for t in args.exclude_tag]
        if own_tag and not args.include_own:
            self.exclude.append(own_tag)
            own = hc.own_stage(own_tag)  # the signature in another stage's journal is `<own stage>-<tag>` (jlog)
            if own:
                self.exclude.append(f"{own}-{own_tag}")

    def accepts(self, text: str) -> bool:
        """Whether the line wakes the caller (a held line does not; see classify)."""
        return self.classify(text) == "wake"

    def classify(self, text: str):
        """"wake", "held" (delivered with the next waking batch, never waking by itself) or None (not for the caller).
        A line that only matched as addressed to `hub` and is signed by another stage's hub or by the pacer is held,
        unless it carries a word that asks for a decision now (HELD_WAKE_RE)."""
        parsed = hc.parse_journal_line(text)
        tag = parsed[1] if parsed else ""
        if tag and any(hc.tag_is(tag, x) for x in self.exclude):
            return None
        if parsed and hc.sub_agent_line(tag, parsed[2]):
            return None  # a sub-agent's start or end line is for the record (hooks/subagent_journal.py)
        if not self.patterns and not self.tags:
            return "wake"
        if any(p.search(text) for p in self.patterns):
            return "wake"
        hits = [t for t in self.tags if hc.tag_is(tag, t) or hc.mentions(text, t, self.stage)]
        if not hits:
            return None
        if set(hits) == {"hub"} and self.passive_sender(tag) and not HELD_WAKE_RE.search(text):
            return "held"
        return "wake"

    def passive_sender(self, tag: str) -> bool:
        """The pacer, or a hub of another stage signing `<stage>-hub[-N]` in this journal (a known stage, not ours)."""
        if not tag:
            return False
        first = tag.split()[0]
        if any(hc.tag_is(first, t) for t in HELD_TAGS):
            return True
        m = re.fullmatch(r"(.+)-hub(?:-\d+)?", first)
        if not m or m.group(1) == self.stage or not hc.STAGE_RE.fullmatch(m.group(1)):
            return False
        try:
            return (hc.root() / m.group(1)).is_dir()
        except OSError:
            return False


def hub_filter(stage: str, tag: str) -> Filter:
    """The Filter of the digest `jwait` that `hub takeover` prints for the hub signing `tag` (bin/hub jwait_command):
    its own tag and `hub`, the status words, the hub's own lines left out in both signatures. The watchdog asks the
    same question with it ("which lines wait for this hub"), so there is one matcher."""
    args = argparse.Namespace(match=[hc.status_pattern()], tag=[tag, "hub"], exclude_tag=[], include_own=True)
    flt = Filter(args, None, stage)
    flt.exclude += [tag, f"{stage}-{tag}"]
    return flt


# A running journal waiter marks itself in <root>/.jwait-state/<stage>/<caller>.armed.json (two stages may both have a
# `hub-1`, so the stage is part of the key), so that the watchdog can tell a hub
# that waits from one that sleeps without a waiter. It is removed when jwait ends, also on SIGTERM / SIGHUP; a file that
# a SIGKILL left behind fails the pid check of armed_live().
ARMED_GRACE_S = 120  # a waiter may overrun its deadline by the settle time of a last batch


def armed_path(caller: str, stage: str):
    """The armed file of `caller` on `stage`, or None for a stage name that is not a valid one. The stage name is used
    as it is (STAGE_RE is filesystem-safe): a sanitised key would make `release` and `release_` share a directory."""
    if not hc.STAGE_RE.fullmatch(stage or ""):
        return None
    return hc.root() / ".jwait-state" / stage / f"{safe_name(caller)}.armed.json"


def write_armed(caller: str, stage: str, tags: list, deadline: dt.datetime) -> None:
    rec = {"pid": os.getpid(), "caller": caller, "stage": stage, "tags": tags, "host_session": hc.session_id(),
           "started": hc.now().isoformat(timespec="seconds"), "deadline": deadline.isoformat(timespec="seconds")}
    path = armed_path(caller, stage)
    if path is None:
        return
    try:
        hc.atomic_write(path, json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError:
        pass  # a read-only home: the waiter works, the watchdog just cannot see it


def clear_armed(caller: str, stage: str) -> None:
    """Remove this process's own armed file (another jwait of the same caller may have replaced it since)."""
    path = armed_path(caller, stage)
    if path is None:
        return
    try:
        if json.loads(path.read_text(encoding="utf-8")).get("pid") == os.getpid():
            path.unlink()
    except (OSError, ValueError, AttributeError):
        pass


def pid_runs_jwait(pid: int):
    """True / False, or None when the process table cannot be read (a sandbox that hides other processes)."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    try:
        cmd = subprocess.run(["ps", "-ww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True,
                             timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return ("jwait" in cmd) if cmd.strip() else None


def armed_live(caller: str, stage: str, at=None, reap: bool = True):
    """The armed record of `caller`'s journal waiter on `stage` when that waiter lives (its pid runs a jwait and its
    deadline has not passed), else None. A stale file (dead pid, a pid that now runs something else, a passed
    deadline) is removed when `reap`; a process table that cannot be read counts as alive (never wake blind)."""
    path = armed_path(caller, stage)
    if path is None:
        return None
    try:
        rec = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(rec, dict):
        return None
    try:
        late = (at or hc.now()) - dt.datetime.fromisoformat(rec["deadline"]) > dt.timedelta(seconds=ARMED_GRACE_S)
        runs = pid_runs_jwait(int(rec["pid"]))
    except (KeyError, TypeError, ValueError):
        late, runs = True, False
    if late or runs is False:
        if reap:
            try:
                path.unlink()
            except OSError:
                pass
        return None
    return rec if rec.get("stage") == stage else None


def _terminate(signum, frame) -> None:
    raise SystemExit(128 + signum)  # unwinds through the `finally` that removes the armed file


def since_cutoff(raw: str, base: dt.datetime) -> dt.datetime:
    """HH:MM (today, hub time zone) or an ISO datetime (naive = hub time zone)."""
    raw = raw.strip()
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", raw)
    if m:
        return base.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
    try:
        t = dt.datetime.fromisoformat(raw)
    except ValueError:
        raise hc.UsageError("--since: use HH:MM or 2026-09-29T14:35") from None
    return (t.replace(tzinfo=hc.TZ) if t.tzinfo is None else t).astimezone(hc.TZ)


def main(argv: list) -> int:
    # no abbreviations: NEXT WAIT rebuilds the command from argv and must recognise every --for/--until/--since
    p = argparse.ArgumentParser(prog="jwait", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                allow_abbrev=False)
    p.add_argument("--journal", action="store_true", help="wait for lines of the stage journal")
    p.add_argument("--stage", default=None)
    p.add_argument("--file", action="append", default=[], help="wait for lines of this file (repeatable)")
    p.add_argument("--hub-events", action="store_true", help="standard hub events plus configured extra wake words")
    p.add_argument("--match", action="append", default=[], help="regular expression (repeatable; adds to --hub-events)")
    p.add_argument("--tag", action="append", default=[], help="lines tagged T or T/…, or addressed @T or @<this stage>-T")
    p.add_argument("--exclude-tag", action="append", default=[], help="do not wake on lines tagged T or T/…")
    p.add_argument("--include-own", action="store_true", help="do not exclude the caller's own tag")
    p.add_argument("--caller", default=None, help="whose seen-state to use (default: own tag or session id)")
    p.add_argument("--settle", type=float, default=20.0, help="seconds to keep collecting after the first match")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--until", default=None, help="deadline HH:MM, HH:MM:SS or ISO (seconds optional)")
    g.add_argument("--for", dest="for_", default=None, help="deadline as a duration: 30m, 6h")
    p.add_argument("--note", default="", help="alarm text")
    p.add_argument("--since", default=None, help="on the initial read, deliver journal lines from HH:MM or an ISO time on")
    p.add_argument("--stream", action="store_true", help="print each batch and keep waiting until the deadline (Monitor)")
    args = p.parse_args(argv)

    stage = hc.check_stage(args.stage or hc.default_stage())
    own_tag = hc.caller_tag(stage)
    caller = args.caller or own_tag or os.environ.get("CLAUDE_CODE_SESSION_ID") or "anon"
    flt = Filter(args, own_tag, stage)
    start = hc.now()
    if args.until:
        deadline = hc.parse_deadline(args.until, start)
    else:
        deadline = start + hc.parse_duration(args.for_ or (STREAM_FOR if args.stream else hc.jwait_for()))
    has_source = args.journal or bool(args.file)
    if not has_source and not (args.until or args.for_):
        raise hc.UsageError("no source (--journal/--file) and no deadline (--until/--for)")
    if args.settle < 0:
        raise hc.UsageError("--settle cannot be negative")
    since = since_cutoff(args.since, start) if args.since else None

    journals = JournalSources(stage, start.date() - dt.timedelta(days=1)) if args.journal else None
    partial_after = max(args.settle, 1.0)
    files = [Source(f"file:{os.path.abspath(f)}", Path(os.path.abspath(f)), os.path.basename(f), False, partial_after)
             for f in args.file]
    state = load_state(caller)
    # Baseline: a journal day the caller has no state for, read at start, is not news, except a
    # day later than the latest day the caller has read (midnight rollover) and lines from --since.
    # Lines that appear after the start are always news. --file sources never baseline: a script
    # may have asked its question before jwait started.
    start_day = start.date().isoformat()
    known_days = [k.rsplit(":", 1)[1] for k in state if k.startswith(f"journal:{stage}:")]
    latest_known = max(known_days) if known_days else None
    seen_now: dict = {}  # sid -> set of keys seen this run
    baselined = [0]
    matched: list = []
    held: list = []  # (sid, key, label, text) of held lines not yet delivered: not saved as seen until printed
    held_since = [0.0]  # monotonic time the oldest undelivered held line was seen
    held_max = float(os.environ.get("JWAIT_HELD_MAX_S") or HELD_MAX_S)  # the environment: the tests' short clock
    first_match_at = None

    def all_sources():
        return (journals.sources() if journals else []) + files

    def since_hit(src, text: str) -> bool:
        """A journal line stamped at or after --since: delivered on the initial read even if seen before."""
        if not (since and src.is_journal):
            return False
        parsed = hc.parse_journal_line(text)
        if not parsed:
            return False
        hh, mm = parsed[0].split(":")
        day = dt.date.fromisoformat(src.sid.rsplit(":", 1)[1])
        return dt.datetime.combine(day, dt.time(int(hh), int(mm)), tzinfo=hc.TZ) >= since.replace(second=0, microsecond=0)

    def is_news(src, text: str, initial: bool) -> bool:
        if not src.is_journal or src.sid in state or not initial:
            return True
        day = src.sid.rsplit(":", 1)[1]
        if (latest_known and day > latest_known) or day > start_day:
            return True  # a day after the latest one read, or one that began while this run waited (midnight)
        if since_hit(src, text):
            return True
        baselined[0] += 1
        return False

    def scan() -> None:
        nonlocal first_match_at
        for src in all_sources():
            known = set(state.get(src.sid, {}).get("seen", []))
            initial = src.polls == 0
            seen_run = seen_now.setdefault(src.sid, set())
            for key, text in src.poll():
                replay = initial and since_hit(src, text)  # --since replays even what was seen before
                dup = key in seen_run or (key in known and not replay)  # seen_run: a rewrite during this run
                seen_run.add(key)
                if dup or not is_news(src, text, initial):
                    continue
                kind = flt.classify(text)
                if kind == "held":
                    if not held:
                        held_since[0] = time.monotonic()
                    held.append((src.sid, key, src.label, text))
                elif kind == "wake":
                    matched.append((src.label, text))
                    if first_match_at is None:
                        first_match_at = time.monotonic()

    def finish(delivered_held: bool) -> None:
        """Save what was seen; held lines count as seen only once printed (a killed waiter delivers them next time)."""
        pending: dict = {}
        if not delivered_held:
            for sid, key, _, _ in held:
                pending.setdefault(sid, set()).add(key)
        updates = {}
        for src in all_sources():
            seen = seen_now.get(src.sid, set()) - pending.get(src.sid, set())
            if seen or src.present:
                updates[src.sid] = (seen, src.present)
        if updates:
            save_state(caller, updates)

    def deliver() -> None:
        finish(True)
        warn_baseline()
        print_block(matched, [(label, text) for _, _, label, text in held])
        sys.stdout.flush()
        matched.clear()
        held.clear()
        baselined[0] = 0

    def warn_baseline() -> None:
        if baselined[0]:
            print(f"first run of [{caller}] on the journal: {baselined[0]} lines marked as seen without delivery; "
                  "--since HH:MM or an ISO time in the next run delivers lines from that time on")

    what = []
    if args.journal:
        what.append(f"journal {stage}")
    what += [f"file {f}" for f in args.file]
    if has_source:
        scan()  # the baseline read comes first: the line below means "armed", what is written after it is news
    if args.journal:
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, _terminate)
        write_armed(caller, stage, args.tag, deadline)
    print(f"jwait [{caller}]: waiting for {', '.join(what) or 'the deadline only'} until {fmt_deadline(deadline)}", flush=True)

    watch = DeadAgentWatch(stage) if args.journal else None
    try:
        while True:
            if watch:
                watch.tick()
            if has_source:
                scan()
            t = hc.now()
            held_due = bool(held) and time.monotonic() - held_since[0] >= held_max  # held long enough: deliver now
            settled = held_due or (first_match_at is not None and time.monotonic() - first_match_at >= args.settle)
            if settled or (matched and t >= deadline):
                deliver()
                if not args.stream:
                    print_next_wait(args, argv, stage)
                    return 0
                first_match_at = None
                if t < deadline:
                    continue
                # a stream past its deadline ends with the ALARM even while lines keep coming: the hub re-arms on it
                print(f"ALARM {args.note}".rstrip() + f" (deadline {fmt_deadline(deadline)})")
                print_next_wait(args, argv, stage)
                return 3
            if t >= deadline:
                finish(bool(held))
                warn_baseline()
                if held:
                    print_held([(label, text) for _, _, label, text in held])
                print(f"ALARM {args.note}".rstrip() + f" (deadline {fmt_deadline(deadline)})")
                print_next_wait(args, argv, stage)
                return 3
            time.sleep(POLL_S)
    except KeyboardInterrupt:
        return 130
    finally:
        if args.journal:
            clear_armed(caller, stage)


def stage_busy(stage: str) -> list:
    """What of the stage runs now: live headless agents ("agent <role>") and `await` supervisors ("await <label>").
    Unreadable state counts as nothing running for that item; the watchdog, not this hint, guards a hung process."""
    out = []
    base = hc.root() / stage / "agents"
    try:
        metas = sorted(base.glob("*/meta.json")) if base.is_dir() else []
    except OSError:
        metas = []
    for mp in metas:
        try:
            meta = json.loads(mp.read_text(encoding="utf-8"))
            pid = int(meta.get("pid") or 0)
            if not pid:
                continue
            os.kill(pid, 0)
            cmd = subprocess.run(["ps", "-ww", "-o", "command=", "-p", str(pid)], capture_output=True, text=True,
                                 timeout=10).stdout
            token = meta.get("process_token") or meta.get("session_id")
            if token and token in cmd:
                out.append(f"agent {mp.parent.name}")
        except (OSError, ValueError, TypeError, subprocess.SubprocessError):
            continue
    try:
        ps = subprocess.run(["ps", "-ww", "-A", "-o", "command="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        ps = ""
    # a supervisor of THIS hub home's stage: its --log lies under <root>/<stage>/ (bin/await); the stage name alone
    # would also match another home's stage of the same name (a test suite running beside a live hub)
    home = re.escape(str(hc.root() / stage) + os.sep)
    for line in ps.splitlines():
        if "await" in line and " --wait" in line and re.search(r"--log\s+" + home, line):
            m = re.search(r"--label\s+(\S+)", line)
            out.append(f"await {m.group(1) if m else ''}".rstrip())
    return out


def bash_cap_ms() -> int:
    try:
        return int(os.environ.get("BASH_MAX_TIMEOUT_MS") or BASH_CAP_DEFAULT_MS)
    except ValueError:
        return BASH_CAP_DEFAULT_MS


def next_wait_argv(argv: list) -> list:
    """The caller's own arguments without the wait form and the one-off replay (--stream, --for, --until, --since)."""
    out, skip = [], False
    for a in argv:
        if skip:
            skip = False
            continue
        if a == "--stream":
            continue
        if a in ("--for", "--until", "--since"):
            skip = True
            continue
        if a.startswith(("--for=", "--until=", "--since=")):
            continue
        out.append(a)
    return out


def print_next_wait(args, argv: list, stage: str) -> None:
    """The NEXT WAIT line of a Claude hub's journal waiter (see the module doc)."""
    if not args.journal or hc.host_engine() == "codex":
        return
    rest = " ".join(shlex.quote(a) for a in next_wait_argv(argv))
    busy = stage_busy(stage)
    if busy:
        print(f"NEXT WAIT: running in {stage}: {', '.join(busy)[:200]} — one Monitor, timeout_ms {MONITOR_TIMEOUT_MS}: "
              f"jwait {rest} --stream")
        return
    cap_s = max(2, bash_cap_ms() // 1000)
    margin = min(300, max(1, cap_s // 10))  # the Bash timeout outlives the wait by this much, inside the cap
    idle_s = min(IDLE_FOR_S, cap_s - margin)
    span = f"{idle_s // 60}m" if idle_s % 60 == 0 else f"{idle_s}s"
    print(f"NEXT WAIT: nothing runs in {stage} — no Monitor; ONE Bash run_in_background: true, timeout "
          f"{(idle_s + margin) * 1000}: jwait {rest} --for {span}")


def fmt_deadline(t) -> str:
    return f"{t:%d.%m %H:%M:%S}" if t.second else f"{t:%d.%m %H:%M}"


def print_block(matched: list, held: list = ()) -> None:
    print(f"NEW: {len(matched)} lines")
    print_lines(matched)
    if held:
        print_held(held)


def print_held(held: list) -> None:
    print(f"HELD (did not wake you): {len(held)} lines")
    print_lines(held)


def print_lines(lines: list) -> None:
    labels = {lab for lab, _ in lines}
    for i, (label, text) in enumerate(lines):
        if i >= MAX_OUT_LINES:
            print(f"… {len(lines) - MAX_OUT_LINES} more lines — read the source")
            break
        if len(text) > MAX_LINE_CHARS:
            text = text[:MAX_LINE_CHARS] + " …"
        print(f"{label}: {text}" if len(labels) > 1 or not label.startswith("journal") else text)


if __name__ == "__main__":
    raise SystemExit(hc.run_main(main, sys.argv[1:]))
