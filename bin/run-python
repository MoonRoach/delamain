#!/bin/sh
# Launch with a compatible runtime without changing the system Python.
set -eu

minimum=3.10
if [ "${1:-}" = "--min-version" ]; then
    minimum=${2:-}
    case "$minimum" in 3.10|3.11) ;; *) echo "run-python: --min-version must be 3.10 or 3.11" >&2; exit 2 ;; esac
    shift 2
fi
if [ "$#" -eq 0 ]; then
    echo "Usage: run-python [--min-version 3.10|3.11] SCRIPT [ARGS...]" >&2
    exit 2
fi

compatible() {
    "$1" -c 'import sys; raise SystemExit(sys.version_info < tuple(map(int, sys.argv[1].split("."))))' "$minimum" </dev/null >/dev/null 2>&1
}

if [ -n "${DELAMAIN_PYTHON:-}" ]; then
    if compatible "$DELAMAIN_PYTHON"; then
        exec "$DELAMAIN_PYTHON" "$@"
    fi
    echo "run-python: DELAMAIN_PYTHON must name an executable Python $minimum+ interpreter: $DELAMAIN_PYTHON" >&2
    exit 1
fi

for candidate in python3 python3.15 python3.14 python3.13 python3.12 python3.11 python3.10 python; do
    if command -v "$candidate" >/dev/null 2>&1 && compatible "$candidate"; then
        exec "$candidate" "$@"
    fi
done
echo "run-python: Python $minimum+ was not found on PATH; install a compatible interpreter or set DELAMAIN_PYTHON to its executable" >&2
exit 1
