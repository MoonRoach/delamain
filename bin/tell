#!/usr/bin/env python3
"""Write to another stage's hub: a journal line addressed by the registry, and the registered direct address.

  tell <target-stage> "text" [--question | --urgent] [--role hub] [--address]
  tell <target-stage> [options] -- "-text that starts with a dash"

The target's current holder of the role (default hub) is read from <target-stage>/roles.json — the registry, not a
session list: a replaced hub can still run under the same display name. Then:
  1. one line is appended to the target stage's journal, "@hub text" ("@<role> text" for --role; "@hub QUESTION text"
     with --question), signed with your stage-qualified tag (`[dolya-hub-3]`, as `jlog` does in a foreign journal), so
     the holder's `jwait --tag hub` hears it. A plain line does not wake that hub: its jwait holds it and prints it
     with the next batch that does wake it, or at its deadline (at most ~30 minutes later). --question (QUESTION)
     and --urgent (URGENT) wake it at once; so do the status words and FAILED, TIMEOUT or CONFLICT in the text;
  2. the direct address is printed for the rare case a direct message is needed (the other hub must act before its
     next wake-up): the full session id, kind and title; for a Claude session the name a cross-session message
     goes to (from `claude agents --json` by session id; skipped silently when the CLI does not answer). Codex uses
     `agent send` for a detached holder (including one promoted to hub), or `codex queue --thread <UUID>` on a CLI
     with queue support for explicit queued follow-ups, never a Claude session name.
For a non-detached Codex recipient tell dispatches immediately through the existing public app-server proxy:
active turns use turn/steer with exact expectedTurnId; observed loaded idle threads use turn/start with delivery
mode unverified (the acknowledgement may refer to a turn another client started). Unavailable runtimes
produce a pending native-caller handoff: the caller must execute the supported native send immediately, before
waiting or any next action, after verifying human authority and the current registry UUID. A handoff alone is
not delivery. Failed/pending/unknown dispatch exits 1; unknown sends must not be retried through another transport.
A headless agent reads its inbox, not a journal: for a holder of kind headless tell delivers through
`agent send --stage <stage> <role> "text (from <your tag>)"` itself (it journals the line too), says so, and exits with
that command's code.
The answer reaches you only in YOUR journal: the other hub answers with `tell <your stage> "…"`; its jwait does not read
your stage's journal, and yours does not read its.
The journal retains the audit trail between hubs; non-detached Codex delivery is immediate when supported.
A direct message goes only to the registry address, never to a session picked by its name in a list. Text that starts with a dash goes after `--`.
--address: print only the direct address, write nothing (no text allowed).
Hub home: `hub home` shows which and why. Exit: 0 ok, 1 stage or holder not found / write or delivery failed, 2 usage
(no tag to sign with, empty text, text with --address).
"""
from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hubcore as hc  # noqa: E402
import codex_sessions  # noqa: E402
import codex_tell  # noqa: E402


def stages_with(role: str) -> list:
    """Stages of the hub home whose registry has a live holder of `role`."""
    names = []
    try:
        dirs = sorted(d for d in hc.root().iterdir() if (d / "roles.json").is_file())
    except OSError:
        return names
    for d in dirs:
        try:
            if role in hc.roles_load(d.name)["roles"]:
                names.append(d.name)
        except (hc.Failure, hc.UsageError):
            continue
    return names


def holder(stage: str, role: str) -> dict:
    """The registry record of the live holder of `role` in `stage`; Failure listing the stages that have one."""
    rec = None
    if hc.roles_path(stage).is_file():
        rec = hc.roles_load(stage)["roles"].get(role)
    if rec:
        return rec
    why = f"stage {stage!r} has no registry" if not hc.roles_path(stage).is_file() else f"stage {stage!r} has no {role!r} in its registry"
    have = ", ".join(stages_with(role)) or "none"
    raise hc.Failure(f"{why} ({hc.roles_path(stage)}); stages with a {role!r}: {have}" + hc.elsewhere_hint(stage))


def claude_name(rec: dict) -> str:
    """The name of the Claude session in `claude agents --json`, matched by session id; "" when it is not there or
    the CLI does not answer (bounded and silent: the journal line is what matters)."""
    ids = {i for i in (rec.get("session"), rec.get("cli_session_id")) if i}
    try:
        cli = hc.find_claude(persist=False)
        if cli is None:
            return ""
        res = subprocess.run([cli.path, "agents", "--json"], capture_output=True, text=True, timeout=10,
                             env=hc.child_env(), stdin=subprocess.DEVNULL)
        rows = json.loads(res.stdout)
    except (hc.Failure, OSError, subprocess.SubprocessError, ValueError):
        return ""
    for r in rows if isinstance(rows, list) else []:
        if isinstance(r, dict) and ids & {r.get("sessionId"), r.get("id")} and r.get("name"):
            return str(r["name"])
    return ""


def address_lines(stage: str, role: str, rec: dict) -> list:
    kind = rec.get("kind") or "?"
    lines = [f"direct address of {role} in {stage} — only if the journal cannot do:",
             f"  session  {rec.get('session')}",
             f"  kind     {kind}",
             f"  title    \"{rec.get('title') or role}\""]
    worker = codex_sessions.detached(stage, rec)
    if worker:
        automatic = "   (tell does this itself)" if kind == "headless" else ""
        lines.append(f"  send     agent send --stage {shlex.quote(stage)} {shlex.quote(worker['role'])} \"…\"{automatic}")
    elif kind == "headless":
        lines.append(f"  send     agent send --stage {stage} {role} \"…\"   (tell does this itself)")
    elif rec.get("engine") == "codex":
        sid = rec.get("cli_session_id") or rec.get("session")
        lines.append(f"  queue    codex queue --thread {shlex.quote(str(sid))} --message \"…\"   (CLI with queue support)")
    else:
        name = claude_name(rec)
        if name:
            lines.append(f"  name     {name}   (cross-session message to this name)")
    return lines


def deliver_headless(stage: str, role: str, tag: str, text: str) -> int:
    """A headless agent reads its inbox only: hand the text to `agent send` (inbox while alive, resume after exit; it
    journals the line itself) and return its exit code."""
    cmd = [sys.executable, str(hc.BIN / "agent"), "send", "--stage", stage, role, f"{text} (from {tag})"]
    try:
        res = subprocess.run(cmd, env=hc.child_env(), stdin=subprocess.DEVNULL)
    except OSError as e:
        raise hc.Failure(f"could not run agent send: {e}") from None
    print(f"{role} in {stage} is headless: delivered through `agent send --stage {stage} {role}` "
          f"(exit {res.returncode}), not as a journal line of its own" if res.returncode == 0 else
          f"{role} in {stage} is headless: `agent send --stage {stage} {role}` failed (exit {res.returncode})")
    return res.returncode


def main(argv: list) -> int:
    p = argparse.ArgumentParser(prog="tell", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("stage", help="the stage whose hub (or --role) is written to")
    p.add_argument("text", nargs="*", help="line text (newlines are collapsed); a text starting with '-' goes after --; none with --address")
    p.add_argument("--question", action="store_true", help="prefix the text with QUESTION (a jwait wake word)")
    p.add_argument("--urgent", action="store_true", help="prefix the text with URGENT: the other hub must act before its next wake")
    p.add_argument("--role", default="hub", help="role to address (default: hub)")
    p.add_argument("--address", action="store_true", help="print only the direct address, write nothing")
    args = p.parse_intermixed_args(argv)  # options between the stage and a nargs="*" text: plain parse_args drops the text on older Pythons
    stage = hc.check_stage(args.stage)
    text = " ".join(args.text).strip()
    if args.address and text:
        raise hc.UsageError("--address takes no text")
    if not args.address and not text:
        raise hc.UsageError("empty text")
    if args.question and args.urgent:
        raise hc.UsageError("--question and --urgent: pick one (a question wakes the hub too)")
    prefix = "QUESTION " if args.question else "URGENT " if args.urgent else ""
    rec = holder(stage, args.role)
    if not args.address:
        tag = hc.signing_tag(stage)
        if not tag:
            raise hc.UsageError("no tag: set $HUB_TAG or register this session (the first hub of a stage: "
                                "`hub start --stage S --goal \"<what the stage delivers>\" --session $CLAUDE_CODE_SESSION_ID`; anyone else: "
                                "`roles set <role> <session id> --tag …`)")
        if rec.get("kind") == "headless":
            return deliver_headless(stage, args.role, tag, prefix + text)
        try:
            line = hc.journal_append(stage, tag, f"@{args.role} " + prefix + text)
        except OSError as e:
            raise hc.Failure(f"could not write the journal {hc.journal_path(stage)}: {e}") from None
        print(line)
        if rec.get("engine") == "codex" and not codex_sessions.detached(stage, rec):
            result = codex_tell.dispatch(stage, args.role, rec,
                                         prefix + text + f" (from {tag})",
                                         {"tag": tag, "journal_path": str(hc.journal_path(stage)), "journal_line": line})
            print("codex tell receipt: " + json.dumps(result, ensure_ascii=False))
            # Pending native work is not successful delivery. Never silently retry unknown sends.
            return 0 if result["state"] in ("steered", "accepted") else 1
    print("\n".join(address_lines(stage, args.role, rec)))
    return 0


if __name__ == "__main__":
    raise SystemExit(hc.run_main(main, sys.argv[1:]))
