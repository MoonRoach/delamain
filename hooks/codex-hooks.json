{
  "description": "Delamain Codex lifecycle and supported local-tool guards. Tool hooks do not cover hosted tools or write_stdin input.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/questions.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/delegation.py\" session-start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/path_shadow.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/board_locks.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/polling_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/kill_guard.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/scan_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/handoff_size.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Agent|Task|Workflow|SendMessage|spawn_agent|resume_agent|send_input|send_message|followup_task|collaboration(?:\\.|__)?(?:spawn_agent|resume_agent|send_input|send_message|followup_task))$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/delegation.py\" pre-tool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/context_budget.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/delegation.py\" prompt",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/context_budget.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/bin/run-python\" --min-version 3.11 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/context_budget.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
